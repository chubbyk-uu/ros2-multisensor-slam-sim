<?xml version="1.0"?>
<robot name="slam_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="sensor_variant" default="2d"/>
  <xacro:arg name="camera_variant" default="none"/>
  <xacro:arg name="odometry_mode" default="wheel"/>
  <xacro:arg name="left_wheel_friction" default="1.2"/>
  <xacro:arg name="right_wheel_friction" default="1.2"/>
  <xacro:arg name="lidar_3d_x" default="-0.07"/>
  <xacro:arg name="lidar_3d_y" default="0.0"/>
  <xacro:arg name="lidar_3d_z" default="0.18"/>
  <xacro:arg name="lidar_3d_roll" default="0.0"/>
  <xacro:arg name="lidar_3d_pitch" default="0.0"/>
  <xacro:arg name="lidar_3d_yaw" default="0.0"/>
  <xacro:arg name="lidar_3d_horizontal_samples" default="720"/>
  <xacro:arg name="lidar_3d_horizontal_min_angle" default="-3.141592653589793"/>
  <xacro:arg name="lidar_3d_horizontal_max_angle" default="3.1328660073298216"/>
  <xacro:arg name="lidar_3d_vertical_samples" default="16"/>
  <xacro:arg name="lidar_3d_vertical_min_angle" default="-0.2617993877991494"/>
  <xacro:arg name="lidar_3d_vertical_max_angle" default="0.2617993877991494"/>
  <xacro:arg name="lidar_3d_update_rate" default="10.0"/>
  <xacro:arg name="lidar_3d_minimum_range" default="0.20"/>
  <xacro:arg name="lidar_3d_maximum_range" default="20.0"/>
  <xacro:arg name="lidar_3d_noise_stddev" default="0.01"/>
  <xacro:arg name="rgbd_width" default="640"/>
  <xacro:arg name="rgbd_height" default="480"/>
  <xacro:arg name="rgbd_update_rate" default="30.0"/>
  <xacro:arg name="rgbd_horizontal_fov" default="1.2217304763960306"/>
  <xacro:arg name="rgbd_minimum_depth" default="0.20"/>
  <xacro:arg name="rgbd_maximum_depth" default="6.0"/>
  <xacro:arg name="imu_update_rate" default="100.0"/>
  <xacro:arg name="imu_angular_velocity_noise_stddev" default="0.002"/>
  <xacro:arg name="imu_angular_velocity_bias_stddev" default="0.0002"/>
  <xacro:arg name="imu_linear_acceleration_noise_stddev" default="0.02"/>
  <xacro:arg name="imu_linear_acceleration_bias_stddev" default="0.005"/>

  <xacro:include filename="$(find slam_robot_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find slam_robot_description)/urdf/inertial_macros.xacro"/>

  <!-- Main dimensions, in SI units. -->
  <xacro:property name="base_length" value="0.45"/>
  <xacro:property name="base_width" value="0.32"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="base_mass" value="12.0"/>
  <!-- The drive axle is 7 cm ahead of the chassis geometric center. -->
  <xacro:property name="drive_axle_offset" value="0.07"/>

  <xacro:property name="wheel_radius" value="0.075"/>
  <xacro:property name="wheel_width" value="0.035"/>
  <!-- Joint-center spacing used by the robot geometry. -->
  <xacro:property name="wheel_separation" value="0.34"/>
  <!--
    ODE's finite-width cylinder contacts make the effective ground track
    narrower than the joint-center spacing. This value is calibrated from
    Gazebo ground-truth yaw against wheel odometry during an in-place turn.
  -->
  <xacro:property name="effective_wheel_separation" value="0.306"/>
  <xacro:property name="wheel_mass" value="0.65"/>

  <xacro:property name="caster_radius" value="0.04"/>
  <xacro:property name="caster_mass" value="0.15"/>
  <xacro:property name="caster_offset_from_chassis_center" value="0.15"/>

  <xacro:property name="lidar_radius" value="0.045"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="lidar_mass" value="0.18"/>
  <xacro:property name="lidar_mount_radius" value="0.025"/>
  <xacro:property name="lidar_mount_height" value="0.10"/>
  <xacro:property name="lidar_mount_mass" value="0.12"/>

  <!-- The 2D and 3D LiDAR variants are mutually exclusive. -->
  <xacro:property name="lidar_3d_mount_radius" value="0.028"/>
  <xacro:property name="lidar_3d_mount_height" value="0.085"/>
  <xacro:property name="lidar_3d_mount_mass" value="0.10"/>
  <xacro:property name="lidar_3d_radius" value="0.055"/>
  <xacro:property name="lidar_3d_height" value="0.07"/>
  <xacro:property name="lidar_3d_mass" value="0.32"/>

  <xacro:property name="imu_length" value="0.04"/>
  <xacro:property name="imu_width" value="0.03"/>
  <xacro:property name="imu_height" value="0.015"/>
  <xacro:property name="imu_mass" value="0.02"/>

  <!--
    The RGB-D optical centre is aligned with the front edge of the asymmetric
    Nav2 footprint, not the chassis front face at x=0.225 m. The housing extends
    rearward, so enabling the camera does not enlarge that footprint. Its top
    remains below the lowest -15 degree 3D LiDAR ray.
  -->
  <xacro:property name="camera_x" value="0.155"/>
  <xacro:property name="camera_z" value="0.09"/>
  <xacro:property name="camera_body_length" value="0.03"/>
  <xacro:property name="camera_body_width" value="0.14"/>
  <xacro:property name="camera_body_height" value="0.04"/>
  <xacro:property name="camera_body_mass" value="0.09"/>
  <xacro:property name="camera_mount_length" value="0.03"/>
  <xacro:property name="camera_mount_width" value="0.04"/>
  <xacro:property name="camera_mount_height" value="0.015"/>
  <xacro:property name="camera_mount_mass" value="0.03"/>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="${-drive_axle_offset} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="${-drive_axle_offset} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <origin xyz="${-drive_axle_offset} 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${base_mass * (base_width * base_width + base_height * base_height) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${base_mass * (base_length * base_length + base_height * base_height) / 12.0}"
        iyz="0.0"
        izz="${base_mass * (base_length * base_length + base_width * base_width) / 12.0}"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + base_height / 2.0}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="drive_wheel" params="side reflect">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <!-- The wheel cylinder axis is y in the link frame. -->
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="${wheel_mass * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"
          ixy="0.0"
          ixz="0.0"
          iyy="${wheel_mass * wheel_radius * wheel_radius / 2.0}"
          iyz="0.0"
          izz="${wheel_mass * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"/>
      </inertial>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin
        xyz="0 ${reflect * wheel_separation / 2.0} ${-base_height / 2.0}"
        rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left" reflect="1"/>
  <xacro:drive_wheel side="right" reflect="-1"/>

  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertial mass="${caster_mass}" radius="${caster_radius}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin
      xyz="${-(drive_axle_offset + caster_offset_from_chassis_center)} 0 ${-(wheel_radius + base_height / 2.0 - caster_radius)}"
      rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="${imu_length} ${imu_width} ${imu_height}"/>
      </geometry>
      <material name="accent_orange"/>
    </visual>
    <inertial>
      <mass value="${imu_mass}"/>
      <inertia
        ixx="${imu_mass * (imu_width * imu_width + imu_height * imu_height) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${imu_mass * (imu_length * imu_length + imu_height * imu_height) / 12.0}"
        iyz="0.0"
        izz="${imu_mass * (imu_length * imu_length + imu_width * imu_width) / 12.0}"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:if value="${'$(arg camera_variant)' == 'rgbd'}">
    <link name="camera_mount_link">
      <visual>
        <geometry>
          <box size="${camera_mount_length} ${camera_mount_width} ${camera_mount_height}"/>
        </geometry>
        <material name="accent_orange"/>
      </visual>
      <collision>
        <geometry>
          <box size="${camera_mount_length} ${camera_mount_width} ${camera_mount_height}"/>
        </geometry>
      </collision>
      <xacro:box_inertial
        mass="${camera_mount_mass}"
        length="${camera_mount_length}"
        width="${camera_mount_width}"
        height="${camera_mount_height}"/>
    </link>

    <joint name="camera_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_mount_link"/>
      <origin
        xyz="${camera_x - camera_body_length} 0 ${base_height / 2.0 + camera_mount_height / 2.0}"
        rpy="0 0 0"/>
    </joint>

    <link name="camera_link">
      <visual>
        <origin xyz="${-camera_body_length / 2.0} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${camera_body_length} ${camera_body_width} ${camera_body_height}"/>
        </geometry>
        <material name="sensor_gray"/>
      </visual>
      <collision>
        <origin xyz="${-camera_body_length / 2.0} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${camera_body_length} ${camera_body_width} ${camera_body_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${camera_body_mass}"/>
        <origin xyz="${-camera_body_length / 2.0} 0 0" rpy="0 0 0"/>
        <inertia
          ixx="${camera_body_mass * (camera_body_width * camera_body_width + camera_body_height * camera_body_height) / 12.0}"
          ixy="0.0"
          ixz="0.0"
          iyy="${camera_body_mass * (camera_body_length * camera_body_length + camera_body_height * camera_body_height) / 12.0}"
          iyz="0.0"
          izz="${camera_body_mass * (camera_body_length * camera_body_length + camera_body_width * camera_body_width) / 12.0}"/>
      </inertial>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent link="camera_mount_link"/>
      <child link="camera_link"/>
      <origin
        xyz="${camera_body_length} 0 ${camera_z - (base_height / 2.0 + camera_mount_height / 2.0)}"
        rpy="0 0 0"/>
    </joint>

    <link name="camera_optical_frame"/>

    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_frame"/>
      <!-- REP-103 camera frame (x forward) to optical frame (z forward). -->
      <origin xyz="0 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
    </joint>
  </xacro:if>

  <xacro:unless value="${'$(arg sensor_variant)' == '3d'}">
    <link name="lidar_mount_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_mount_radius}" length="${lidar_mount_height}"/>
      </geometry>
      <material name="accent_orange"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_mount_radius}" length="${lidar_mount_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial
      mass="${lidar_mount_mass}"
      radius="${lidar_mount_radius}"
      length="${lidar_mount_height}"/>
    </link>

    <joint name="lidar_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mount_link"/>
    <origin
      xyz="${-drive_axle_offset} 0 ${base_height / 2.0 + lidar_mount_height / 2.0}"
      rpy="0 0 0"/>
    </joint>

    <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial
      mass="${lidar_mass}"
      radius="${lidar_radius}"
      length="${lidar_height}"/>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="lidar_mount_link"/>
      <child link="lidar_link"/>
      <origin xyz="0 0 ${(lidar_mount_height + lidar_height) / 2.0}" rpy="0 0 0"/>
    </joint>
  </xacro:unless>

  <xacro:if value="${'$(arg sensor_variant)' == '3d'}">
    <link name="lidar_3d_mount_link">
      <visual>
        <geometry>
          <cylinder radius="${lidar_3d_mount_radius}" length="${lidar_3d_mount_height}"/>
        </geometry>
        <material name="accent_orange"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${lidar_3d_mount_radius}" length="${lidar_3d_mount_height}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial
        mass="${lidar_3d_mount_mass}"
        radius="${lidar_3d_mount_radius}"
        length="${lidar_3d_mount_height}"/>
    </link>

    <joint name="lidar_3d_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_3d_mount_link"/>
      <origin
        xyz="$(arg lidar_3d_x) $(arg lidar_3d_y) ${float('$(arg lidar_3d_z)') - (lidar_3d_mount_height + lidar_3d_height) / 2.0}"
        rpy="$(arg lidar_3d_roll) $(arg lidar_3d_pitch) $(arg lidar_3d_yaw)"/>
    </joint>

    <link name="lidar_3d_link">
      <visual>
        <geometry>
          <cylinder radius="${lidar_3d_radius}" length="${lidar_3d_height}"/>
        </geometry>
        <material name="sensor_gray"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${lidar_3d_radius}" length="${lidar_3d_height}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial
        mass="${lidar_3d_mass}"
        radius="${lidar_3d_radius}"
        length="${lidar_3d_height}"/>
    </link>

    <joint name="lidar_3d_joint" type="fixed">
      <parent link="lidar_3d_mount_link"/>
      <child link="lidar_3d_link"/>
      <origin
        xyz="0 0 ${(lidar_3d_mount_height + lidar_3d_height) / 2.0}"
        rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <xacro:include filename="$(find slam_robot_description)/urdf/gazebo.xacro"/>
</robot>
