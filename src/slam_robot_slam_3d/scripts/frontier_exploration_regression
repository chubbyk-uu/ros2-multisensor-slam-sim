#!/usr/bin/env python3

"""Score autonomous frontier exploration without publishing velocity commands."""

import argparse
import math
import sys
import time
from collections import deque

from diagnostic_msgs.msg import DiagnosticArray
from nav2_msgs.msg import CollisionMonitorState
from nav_msgs.msg import OccupancyGrid, Odometry
from rcl_interfaces.msg import Log
import rclpy
from rclpy.node import Node
import rclpy.time
from rclpy.parameter import Parameter
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from rclpy.utilities import remove_ros_args
from std_msgs.msg import Bool
import tf2_ros


CRITICAL_LOG_FRAGMENTS = (
    "process has died",
    "Exception caught",
    "snapshot save failed",
    "snapshot service is unavailable",
    "snapshot request failed",
)

# Nav2 emits these only when a loop misses its configured rate, so counting
# them measures how starved this host was. The literals are pinned by a unit
# test: if Nav2 rewords them the parser would silently report a perfectly
# healthy host for every run, and that error biases towards declaring PASS.
CONTROL_STARVATION_FRAGMENT = "Control loop missed its desired rate"
PLANNER_STARVATION_FRAGMENT = "Planner loop missed its desired rate"


# Outer face of the structured world's perimeter walls, from the SDF: the wall
# centres sit at x -1.5/25.5 and y -1.5/13.5 with 0.2 m thickness.
OUTER_WALL_MINIMUM_X = -1.6
OUTER_WALL_MAXIMUM_X = 25.6
OUTER_WALL_MINIMUM_Y = -1.6
OUTER_WALL_MAXIMUM_Y = 13.6


def normalize_angle(angle):
    return math.atan2(math.sin(angle), math.cos(angle))


def yaw_of(orientation):
    return math.atan2(
        2.0 * (orientation.w * orientation.z + orientation.x * orientation.y),
        1.0 - 2.0 * (orientation.y * orientation.y + orientation.z * orientation.z),
    )


def odometry_pose2d(message):
    position = message.pose.pose.position
    return (position.x, position.y, yaw_of(message.pose.pose.orientation))


def transform_pose2d(transform):
    translation = transform.transform.translation
    return (translation.x, translation.y, yaw_of(transform.transform.rotation))


def relative_pose(origin, pose):
    """Express pose in the frame of origin.

    Both estimates and ground truth start from arbitrary but fixed offsets, so
    comparing them directly measures the offset rather than the drift. Anchoring
    each to its own first sample removes it without assuming the two frames were
    ever aligned.
    """
    delta_x = pose[0] - origin[0]
    delta_y = pose[1] - origin[1]
    cosine = math.cos(-origin[2])
    sine = math.sin(-origin[2])
    return (
        delta_x * cosine - delta_y * sine,
        delta_x * sine + delta_y * cosine,
        normalize_angle(pose[2] - origin[2]),
    )


class TrajectoryError:
    """Position and yaw error of one pose estimate against ground truth."""

    def __init__(self, maximum_pair_age=0.05):
        self.maximum_pair_age = maximum_pair_age
        self.estimate_origin = None
        self.truth_origin = None
        self.samples = 0
        self.latest_position = None
        self.latest_yaw = None
        self.maximum_position = 0.0
        self.maximum_yaw = 0.0

    def observe(self, stamp, estimate, truth_samples):
        if not truth_samples:
            return
        truth_stamp, truth = min(
            truth_samples, key=lambda sample: abs(sample[0] - stamp)
        )
        if abs(truth_stamp - stamp) > self.maximum_pair_age:
            return
        if self.estimate_origin is None:
            self.estimate_origin = estimate
            self.truth_origin = truth
            return
        estimate_relative = relative_pose(self.estimate_origin, estimate)
        truth_relative = relative_pose(self.truth_origin, truth)
        self.latest_position = math.hypot(
            estimate_relative[0] - truth_relative[0],
            estimate_relative[1] - truth_relative[1],
        )
        self.latest_yaw = abs(
            normalize_angle(estimate_relative[2] - truth_relative[2])
        )
        self.maximum_position = max(self.maximum_position, self.latest_position)
        self.maximum_yaw = max(self.maximum_yaw, self.latest_yaw)
        self.samples += 1


def known_free_cells(message):
    return sum(1 for value in message.data if 0 <= value <= 20)


def wall_overshoot(bounds):
    """Return how far a bounding box reaches past each outer wall face.

    Reported per side rather than as one number: the observed smear is
    anisotropic and not yet explained, and a single width or height cannot say
    which wall moved.
    """
    if bounds is None:
        return None
    minimum_x, minimum_y, maximum_x, maximum_y = bounds
    return {
        "west": max(0.0, OUTER_WALL_MINIMUM_X - minimum_x),
        "south": max(0.0, OUTER_WALL_MINIMUM_Y - minimum_y),
        "east": max(0.0, maximum_x - OUTER_WALL_MAXIMUM_X),
        "north": max(0.0, maximum_y - OUTER_WALL_MAXIMUM_Y),
    }


def format_wall_overshoot(bounds):
    overshoot = wall_overshoot(bounds)
    if overshoot is None:
        return "n/a"
    return " ".join(f"{side}={value:.3f} m" for side, value in overshoot.items())


def map_bounds(message, predicate):
    """Return a world-coordinate bounding box for cells selected by predicate."""
    width = message.info.width
    height = message.info.height
    resolution = message.info.resolution
    if width == 0 or height == 0 or resolution <= 0.0:
        return None
    selected = [
        (index % width, index // width)
        for index, value in enumerate(message.data)
        if predicate(value)
    ]
    if not selected:
        return None
    xs, ys = zip(*selected)
    origin = message.info.origin.position
    return (
        origin.x + min(xs) * resolution,
        origin.y + min(ys) * resolution,
        origin.x + (max(xs) + 1) * resolution,
        origin.y + (max(ys) + 1) * resolution,
    )


def bounds_area(bounds):
    if bounds is None:
        return 0.0
    return (bounds[2] - bounds[0]) * (bounds[3] - bounds[1])


def bounds_width(bounds):
    return 0.0 if bounds is None else bounds[2] - bounds[0]


def bounds_height(bounds):
    return 0.0 if bounds is None else bounds[3] - bounds[1]


def format_elapsed(seconds):
    return "n/a" if seconds is None else f"{seconds:.1f} s"


def format_metres(value):
    return "n/a" if value is None else f"{value:.3f} m"


class ExplorationRegression(Node):
    def __init__(self):
        super().__init__(
            "frontier_exploration_regression",
            parameter_overrides=[Parameter("use_sim_time", value=True)],
        )
        self.complete = False
        self.seen_active_exploration = False
        self.latest_free_cells = 0
        self.initial_free_cells = None
        self.maximum_free_cells = 0
        self.maximum_free_area = 0.0
        self.maximum_free_bounds = None
        self.maximum_known_bounds = None
        self.maximum_known_bbox_area = 0.0
        self.maximum_known_bbox_width = 0.0
        self.maximum_known_bbox_height = 0.0
        self.maximum_free_bbox_area = 0.0
        self.successful_goals = 0
        self.failed_goals = 0
        self.unreachable_candidates = 0
        self.collision_transitions = 0
        self.recovery_events = 0
        self.last_collision_action = CollisionMonitorState.DO_NOTHING
        self.truth_distance = 0.0
        self.previous_truth = None
        self.truth_bounds = None
        # Ground truth arrives faster than either estimate, so keep a short
        # window to pair against by stamp rather than by arrival order.
        self.truth_samples = deque(maxlen=400)
        # Two estimates, because they fail differently. laser_odom is the front
        # end alone; map -> base_footprint is what Nav2 and the explorer act on
        # and what the projection is rebuilt from, so only the second can show a
        # pose-graph correction distorting the map.
        self.front_end_error = TrajectoryError()
        self.map_frame_error = TrajectoryError()
        self.last_map_frame_stamp = None
        self.critical_logs = []
        self.control_starvation_warnings = 0
        self.planner_starvation_warnings = 0
        self.completion_reason = ""
        self.probability_unknown_cells = 0
        self.probability_free_cells = 0
        self.probability_partial_cells = 0
        self.probability_occupied_cells = 0
        self.raw_frontier_candidates = 0
        self.blacklisted_frontier_candidates = 0
        self.pose_graph_commits = 0
        self.pose_graph_discards = 0
        self.pose_graph_failures = 0
        self.submap_reinitializations = 0
        self.loop_retrieval_eligible = 0
        self.loop_retrieval_shortlisted = 0
        self.loop_retrieval_descriptor_rejections = 0
        self.loop_retrieval_distance_at_most_0_05 = 0
        self.loop_retrieval_distance_at_most_0_10 = 0
        self.loop_retrieval_distance_at_most_0_15 = 0
        self.loop_retrieval_candidates = 0
        self.loop_verified_candidates = 0
        self.loop_accepted_candidates = 0
        # Wall and simulation elapsed are both recorded because the two stacks
        # do not run at the same real-time factor, so an equal wall-clock
        # budget is not an equal simulated budget.
        self.start_wall = time.monotonic()
        self.start_sim = None
        self.latest_sim = None
        self.completion_wall = None
        self.completion_sim = None
        self.map_updates = 0
        self.first_map_wall = None
        self.last_map_wall = None
        map_qos = QoSProfile(
            depth=1,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
        )
        self.create_subscription(OccupancyGrid, "/map", self.map_callback, map_qos)
        self.create_subscription(
            Bool,
            "/frontier_explorer/complete",
            self.completion_callback,
            map_qos,
        )
        self.create_subscription(
            DiagnosticArray,
            "/frontier_explorer/diagnostics",
            self.diagnostics_callback,
            10,
        )
        # The explorer and front end publish independent diagnostic streams.
        # Subscribe to both so the probability-grid census in the final report
        # reflects the map that drove frontier selection.
        self.create_subscription(
            DiagnosticArray,
            "/custom_slam_3d/front_end_diagnostics",
            self.diagnostics_callback,
            10,
        )
        self.create_subscription(
            CollisionMonitorState,
            "/collision_monitor_state",
            self.collision_callback,
            10,
        )
        self.create_subscription(
            Odometry, "/ground_truth/odom", self.truth_callback, 50
        )
        self.create_subscription(
            Odometry, "/custom_slam_3d/laser_odom", self.front_end_callback, 50
        )
        self.tf_buffer = tf2_ros.Buffer()
        self.tf_listener = tf2_ros.TransformListener(self.tf_buffer, self)
        self.create_subscription(Log, "/rosout", self.log_callback, 100)

    def map_callback(self, message):
        now = time.monotonic()
        if self.first_map_wall is None:
            self.first_map_wall = now
        self.last_map_wall = now
        self.map_updates += 1
        self.latest_free_cells = known_free_cells(message)
        if self.initial_free_cells is None and self.latest_free_cells > 0:
            self.initial_free_cells = self.latest_free_cells
        self.maximum_free_cells = max(
            self.maximum_free_cells, self.latest_free_cells
        )
        cell_area = message.info.resolution * message.info.resolution
        self.maximum_free_area = max(
            self.maximum_free_area, self.latest_free_cells * cell_area
        )
        known_bounds = map_bounds(message, lambda value: value >= 0)
        free_bounds = map_bounds(message, lambda value: 0 <= value <= 20)
        if bounds_area(known_bounds) > self.maximum_known_bbox_area:
            self.maximum_known_bbox_area = bounds_area(known_bounds)
            self.maximum_known_bounds = known_bounds
        self.maximum_known_bbox_width = max(
            self.maximum_known_bbox_width, bounds_width(known_bounds)
        )
        self.maximum_known_bbox_height = max(
            self.maximum_known_bbox_height, bounds_height(known_bounds)
        )
        if bounds_area(free_bounds) > self.maximum_free_bbox_area:
            self.maximum_free_bbox_area = bounds_area(free_bounds)
            self.maximum_free_bounds = free_bounds

    # The caller samples the clock and hands the value in, so every callback
    # stays free of node state and remains testable without a live context.
    def note_sim_time(self, sim_seconds):
        if sim_seconds <= 0.0:
            return
        if self.start_sim is None:
            self.start_sim = sim_seconds
        self.latest_sim = sim_seconds

    def completion_callback(self, message):
        if not message.data:
            self.seen_active_exploration = True
            self.complete = False
        elif self.seen_active_exploration and self.initial_free_cells is not None:
            self.complete = True
            self.completion_wall = time.monotonic() - self.start_wall
            if self.latest_sim is not None and self.start_sim is not None:
                self.completion_sim = self.latest_sim - self.start_sim

    def diagnostics_callback(self, message):
        for status in message.status:
            values = {entry.key: entry.value for entry in status.values}
            if status.name == "frontier_explorer":
                self.successful_goals = int(values.get("successful_goals", 0))
                self.failed_goals = int(values.get("failed_goals", 0))
                self.unreachable_candidates = int(
                    values.get("unreachable_candidates", 0)
                )
                self.raw_frontier_candidates = int(
                    values.get("raw_frontier_candidates", 0)
                )
                self.blacklisted_frontier_candidates = int(
                    values.get("blacklisted_frontier_candidates", 0)
                )
                self.completion_reason = values.get(
                    "completion_reason", self.completion_reason
                )
            elif status.name == "custom_slam_3d/scan_to_map_front_end":
                self.probability_unknown_cells = int(
                    values.get("occupancy_probability_unknown_cells", 0)
                )
                self.probability_free_cells = int(
                    values.get("occupancy_probability_free_cells", 0)
                )
                self.probability_partial_cells = int(
                    values.get("occupancy_probability_partial_cells", 0)
                )
                self.probability_occupied_cells = int(
                    values.get("occupancy_probability_occupied_cells", 0)
                )
                self.pose_graph_commits = int(values.get("pose_graph_commits", 0))
                self.pose_graph_discards = int(values.get("pose_graph_discards", 0))
                self.pose_graph_failures = int(values.get("pose_graph_failures", 0))
                self.submap_reinitializations = int(
                    values.get("submap_reinitializations", 0)
                )
                self.loop_retrieval_eligible = int(
                    values.get("loop_retrieval_eligible_total", 0)
                )
                self.loop_retrieval_shortlisted = int(
                    values.get("loop_retrieval_shortlisted_total", 0)
                )
                self.loop_retrieval_descriptor_rejections = int(
                    values.get("loop_retrieval_descriptor_rejections_total", 0)
                )
                self.loop_retrieval_distance_at_most_0_05 = int(
                    values.get("loop_retrieval_distance_at_most_0_05_total", 0)
                )
                self.loop_retrieval_distance_at_most_0_10 = int(
                    values.get("loop_retrieval_distance_at_most_0_10_total", 0)
                )
                self.loop_retrieval_distance_at_most_0_15 = int(
                    values.get("loop_retrieval_distance_at_most_0_15_total", 0)
                )
                self.loop_retrieval_candidates = int(
                    values.get("loop_retrieval_candidates_total", 0)
                )
                self.loop_verified_candidates = int(
                    values.get("loop_verified_candidates_total", 0)
                )
                self.loop_accepted_candidates = int(
                    values.get("loop_accepted_candidates_total", 0)
                )

    def collision_callback(self, message):
        if (
            message.action_type != CollisionMonitorState.DO_NOTHING
            and message.action_type != self.last_collision_action
        ):
            self.collision_transitions += 1
        self.last_collision_action = message.action_type

    def front_end_callback(self, message):
        stamp = message.header.stamp.sec + 1.0e-9 * message.header.stamp.nanosec
        self.front_end_error.observe(
            stamp, odometry_pose2d(message), self.truth_samples
        )

    def sample_map_frame_pose(self):
        """Read map -> base_footprint at the time of a ground-truth sample.

        Asking for the latest transform instead would compare poses an interval
        apart: the front end future-dates map -> odom by its transform
        tolerance so Nav2 can transform goals stamped between scans, so the
        newest transform carries a stamp ahead of the data behind it. Pairing
        by that stamp charged the estimate with however far the robot travelled
        and turned in the meantime, which at a tenth of a second of rotation is
        several degrees of pure measurement artefact.
        """
        if not self.truth_samples:
            return
        stamp, _ = self.truth_samples[-1]
        if stamp == self.last_map_frame_stamp:
            return
        try:
            transform = self.tf_buffer.lookup_transform(
                "map", "base_footprint",
                rclpy.time.Time(seconds=stamp, nanoseconds=0),
            )
        except tf2_ros.TransformException:
            return
        self.last_map_frame_stamp = stamp
        self.map_frame_error.observe(
            stamp, transform_pose2d(transform), self.truth_samples
        )

    def truth_callback(self, message):
        stamp = message.header.stamp.sec + 1.0e-9 * message.header.stamp.nanosec
        self.truth_samples.append(
            (stamp, odometry_pose2d(message))
        )
        current = (
            message.pose.pose.position.x,
            message.pose.pose.position.y,
        )
        if self.truth_bounds is None:
            self.truth_bounds = (*current, *current)
        else:
            self.truth_bounds = (
                min(self.truth_bounds[0], current[0]),
                min(self.truth_bounds[1], current[1]),
                max(self.truth_bounds[2], current[0]),
                max(self.truth_bounds[3], current[1]),
            )
        if self.previous_truth is not None:
            step = math.hypot(
                current[0] - self.previous_truth[0],
                current[1] - self.previous_truth[1],
            )
            if step < 0.25:
                self.truth_distance += step
        self.previous_truth = current

    def mean_map_interval(self):
        if self.map_updates < 2:
            return None
        return (self.last_map_wall - self.first_map_wall) / (self.map_updates - 1)

    def log_callback(self, message):
        if message.msg.startswith(("Running spin", "Running backup")):
            self.recovery_events += 1
        if CONTROL_STARVATION_FRAGMENT in message.msg:
            self.control_starvation_warnings += 1
        if PLANNER_STARVATION_FRAGMENT in message.msg:
            self.planner_starvation_warnings += 1
        if any(fragment in message.msg for fragment in CRITICAL_LOG_FRAGMENTS):
            if message.msg not in self.critical_logs:
                self.critical_logs.append(message.msg)

    def starvation_rates(self):
        """Return starvation warnings per minute of wall time.

        Absolute counts would penalise long runs: observed completions span
        352-610 s, so a run that simply lasts longer accumulates more chances
        to miss a cycle. Rate keeps the measure comparable across durations.
        """
        elapsed = max(time.monotonic() - self.start_wall, 1.0e-6)
        minutes = elapsed / 60.0
        return (
            self.control_starvation_warnings / minutes,
            self.planner_starvation_warnings / minutes,
        )


def parse_arguments(arguments):
    parser = argparse.ArgumentParser()
    parser.add_argument("--wall-timeout", type=float, default=600.0)
    parser.add_argument("--minimum-successful-goals", type=int, default=1)
    parser.add_argument("--minimum-free-cell-growth", type=int, default=500)
    # The fixed structured-world RTAB-Map baseline reaches 76,012 free cells
    # and 70.778 m.  Half of that is an anti-regression gate, not a target:
    # it only stops the self-developed chain from declaring completion on a
    # map far smaller than the one it produced when this gate was written.
    parser.add_argument("--minimum-final-free-cells", type=int, default=38000)
    parser.add_argument("--minimum-travel-distance", type=float, default=35.0)
    parser.add_argument("--maximum-failed-goals", type=int, default=5)
    parser.add_argument("--maximum-successful-goals", type=int, default=30)
    parser.add_argument("--maximum-collision-transitions", type=int, default=3)
    parser.add_argument("--maximum-recovery-events", type=int, default=5)
    # The closed structured-loop corridor has less than 216 m2 of physical
    # floor area. 240 m2 leaves measurement margin while rejecting a warped
    # map that fabricates free space outside the world.
    parser.add_argument("--maximum-free-area-m2", type=float, default=240.0)
    # Derived from the physical outer wall, 27.2 x 15.2 m, plus room for the
    # wall smear a correct map still shows. Six healthy runs measured
    # 27.05-27.50 m wide and 15.10-16.40 m tall, so the previous 16.5 m height
    # limit had less margin than the run-to-run spread. Height stays a separate
    # check: the warped map this catches was 20.10 m tall while still fitting
    # under an area limit.
    parser.add_argument("--maximum-known-bbox-width-m", type=float, default=28.0)
    # Ten calibration runs measured 14.95-16.80 m. Nine of them sat inside
    # 15.55 m with the map fitting the outer wall exactly; one stretched by
    # 1.6 m in y, pushing north and south out together. That stretch has no
    # known cause and does not correlate with travel, loop closures or
    # front-end resets, so this limit covers it with margin rather than
    # pretending its size is bounded. It still separates cleanly from the
    # 20.10 m a warped map produced.
    parser.add_argument("--maximum-known-bbox-height-m", type=float, default=17.5)
    parser.add_argument("--maximum-known-bbox-area-m2", type=float, default=480.0)
    # Host health is measured as warnings per minute, not per run: completions
    # span 352-610 s, so an absolute count penalises the longer ones. Six runs
    # measured 0.00-0.20/min while healthy and 0.62/min on the starved one.
    # Provisional until a calibration campaign supplies a real distribution.
    parser.add_argument(
        "--maximum-control-starvation-per-minute", type=float, default=0.40)
    # Calibration measured 0.00-0.50/min across ten runs with no host-caused
    # failure, so 0.40 would have flagged a healthy run. Erring loose is the
    # safe direction here: health only ever downgrades a failure, so a
    # too-generous limit reports a host problem as an algorithm one, while a
    # too-tight limit would excuse a real regression as bad luck.
    parser.add_argument(
        "--maximum-planner-starvation-per-minute", type=float, default=0.60)
    parser.add_argument("--maximum-submap-reinitializations", type=int, default=1)
    # A single exploration pass need not revisit a place closely enough to
    # produce a loop. Positive loop recall belongs to the fixed-bag two-lap
    # regression; this test still records any loop activity and graph failures.
    parser.add_argument("--minimum-loop-accepted-candidates", type=int, default=0)
    # Ten runs on the corrected map-pose path measured 0.012-0.091 m and
    # 0.103-0.263 deg. These sit a few times above that while staying an order
    # of magnitude below the 2.717 m and 13.285 deg a run produced when the map
    # was still being rebuilt from wheel odometry. Judged as core criteria: a
    # distorted map is the algorithm's problem, not the host's.
    parser.add_argument("--maximum-map-frame-position-error-m", type=float, default=0.30)
    parser.add_argument("--maximum-map-frame-yaw-error-deg", type=float, default=1.50)
    parser.add_argument("--completion-drain", type=float, default=5.0)
    parsed = parser.parse_args(arguments)
    if parsed.completion_drain < 0.0:
        parser.error("--completion-drain must be non-negative")
    if parsed.maximum_free_area_m2 <= 0.0:
        parser.error("--maximum-free-area-m2 must be positive")
    if parsed.maximum_control_starvation_per_minute < 0.0:
        parser.error("--maximum-control-starvation-per-minute must be non-negative")
    if parsed.maximum_planner_starvation_per_minute < 0.0:
        parser.error("--maximum-planner-starvation-per-minute must be non-negative")
    if (
        parsed.maximum_known_bbox_width_m <= 0.0
        or parsed.maximum_known_bbox_height_m <= 0.0
        or parsed.maximum_known_bbox_area_m2 <= 0.0
    ):
        parser.error("map bounding-box limits must be positive")
    if parsed.maximum_successful_goals < parsed.minimum_successful_goals:
        parser.error("--maximum-successful-goals must allow the required minimum")
    if parsed.maximum_submap_reinitializations < 0:
        parser.error("--maximum-submap-reinitializations must be non-negative")
    if parsed.minimum_loop_accepted_candidates < 0:
        parser.error("--minimum-loop-accepted-candidates must be non-negative")
    return parsed


PASS = 0
FAIL = 1
INFRA_UNSTABLE = 2

# Checks that describe how the robot behaved rather than what the algorithm
# produced. A starved host makes the controller overshoot, so these two can
# fail for reasons that say nothing about SLAM or exploration.
NAVIGATION_BEHAVIOUR_CHECKS = (
    "collision_monitor_budget",
    "navigation_recovery_budget",
)


def classify(checks, host_healthy):
    """Split "the algorithm regressed" from "this host was starved".

    The three outcomes partition every combination, which matters because an
    unpartitioned rule leaves some runs with no verdict at all. Host health is
    recorded for every run but only ever *downgrades* a failure to
    INFRA_UNSTABLE; it never turns a clean run into one, so a merely slow host
    cannot consume the campaign's environment budget on its own.
    """
    core_failures = [
        name for name, passed in checks.items()
        if not passed and name not in NAVIGATION_BEHAVIOUR_CHECKS
    ]
    behaviour_failures = [
        name for name in NAVIGATION_BEHAVIOUR_CHECKS if not checks.get(name, True)
    ]
    if core_failures:
        return FAIL
    if not behaviour_failures:
        return PASS
    return FAIL if host_healthy else INFRA_UNSTABLE


def evaluate(regression, arguments):
    initial = regression.initial_free_cells or 0
    growth = regression.maximum_free_cells - initial
    checks = {
        "exploration_completed": regression.complete,
        "completion_belongs_to_this_run": regression.seen_active_exploration,
        "frontier_goal_succeeded": regression.successful_goals
        >= arguments.minimum_successful_goals,
        "known_free_area_grew": growth >= arguments.minimum_free_cell_growth,
        "final_known_area": regression.maximum_free_cells
        >= arguments.minimum_final_free_cells,
        "free_area_within_structured_world": regression.maximum_free_area
        <= arguments.maximum_free_area_m2,
        "known_map_width_within_structured_world":
        regression.maximum_known_bbox_width <= arguments.maximum_known_bbox_width_m,
        "known_map_height_within_structured_world":
        regression.maximum_known_bbox_height <= arguments.maximum_known_bbox_height_m,
        "known_map_bbox_within_structured_world": regression.maximum_known_bbox_area
        <= arguments.maximum_known_bbox_area_m2,
        "robot_explored_physically": regression.truth_distance
        >= arguments.minimum_travel_distance,
        "failed_goal_budget": regression.failed_goals
        <= arguments.maximum_failed_goals,
        "successful_goal_budget": regression.successful_goals
        <= arguments.maximum_successful_goals,
        "collision_monitor_budget": regression.collision_transitions
        <= arguments.maximum_collision_transitions,
        "navigation_recovery_budget": regression.recovery_events
        <= arguments.maximum_recovery_events,
        "submap_reinitialization_budget": regression.submap_reinitializations
        <= arguments.maximum_submap_reinitializations,
        "loop_closure_recalled": regression.loop_accepted_candidates
        >= arguments.minimum_loop_accepted_candidates,
        "pose_graph_results_applied":
        arguments.minimum_loop_accepted_candidates == 0
        or regression.pose_graph_commits > 0,
        "no_pose_graph_failures": regression.pose_graph_failures == 0,
        # Absent measurements fail rather than pass: a run that never paired a
        # pose with ground truth has not shown the map to be sound.
        "map_frame_position_error": regression.map_frame_error.samples > 0 and
        regression.map_frame_error.maximum_position
        <= arguments.maximum_map_frame_position_error_m,
        "map_frame_yaw_error": regression.map_frame_error.samples > 0 and
        math.degrees(regression.map_frame_error.maximum_yaw)
        <= arguments.maximum_map_frame_yaw_error_deg,
        "no_critical_logs": not regression.critical_logs,
    }
    print("RESULT frontier exploration", flush=True)
    print(
        f"  free cells: initial={initial} maximum={regression.maximum_free_cells} "
        f"growth={growth}",
        flush=True,
    )
    print(
        f"  free area={regression.maximum_free_area:.3f} m2 "
        f"free bbox={regression.maximum_free_bbox_area:.3f} m2 "
        f"{regression.maximum_free_bounds} "
        f"known bbox={regression.maximum_known_bbox_area:.3f} m2 "
        f"{regression.maximum_known_bounds} "
        f"maximum known width={regression.maximum_known_bbox_width:.3f} m "
        f"height={regression.maximum_known_bbox_height:.3f} m",
        flush=True,
    )
    # Each side is reported separately because the smear is anisotropic and
    # unexplained: height varied 1.3 m across six healthy runs while width
    # varied 0.45 m. Per-side extents show whether one wall, the portal, or a
    # global pose correction is responsible, without guessing now.
    print(
        "  known map extent vs outer wall "
        f"(x {OUTER_WALL_MINIMUM_X:.2f}..{OUTER_WALL_MAXIMUM_X:.2f}, "
        f"y {OUTER_WALL_MINIMUM_Y:.2f}..{OUTER_WALL_MAXIMUM_Y:.2f}): "
        f"{format_wall_overshoot(regression.maximum_known_bounds)}",
        flush=True,
    )
    print(
        f"  goals: succeeded={regression.successful_goals} "
        f"failed={regression.failed_goals} "
        f"unreachable={regression.unreachable_candidates}",
        flush=True,
    )
    print(
        f"  truth distance={regression.truth_distance:.3f} m "
        f"collision transitions={regression.collision_transitions} "
        f"recovery events={regression.recovery_events}",
        flush=True,
    )
    print(
        f"  truth bbox={bounds_area(regression.truth_bounds):.3f} m2",
        flush=True,
    )
    # Reported, not yet judged. A limit set before any distribution exists is
    # the mistake this campaign process was built to avoid, so these numbers
    # first have to be collected across a batch.
    for label, error in (
        ("front end", regression.front_end_error),
        ("map frame", regression.map_frame_error),
    ):
        print(
            f"  {label} error: samples={error.samples} "
            f"position final={format_metres(error.latest_position)} "
            f"peak={error.maximum_position:.3f} m "
            f"yaw peak={math.degrees(error.maximum_yaw):.3f} deg",
            flush=True,
        )
    print(
        f"  completion: reason={regression.completion_reason or 'none'!r} "
        f"wall={format_elapsed(regression.completion_wall)} "
        f"sim={format_elapsed(regression.completion_sim)} "
        f"budget={arguments.wall_timeout:.0f} s wall",
        flush=True,
    )
    print(
        f"  map delivery: updates={regression.map_updates} "
        f"mean interval={format_elapsed(regression.mean_map_interval())}",
        flush=True,
    )
    print(
        "  probability cells: "
        f"unknown={regression.probability_unknown_cells} "
        f"free={regression.probability_free_cells} "
        f"partial={regression.probability_partial_cells} "
        f"occupied={regression.probability_occupied_cells}",
        flush=True,
    )
    print(
        "  pose graph: "
        f"commits={regression.pose_graph_commits} "
        f"discards={regression.pose_graph_discards} "
        f"failures={regression.pose_graph_failures}",
        flush=True,
    )
    print(
        "  front-end recovery: "
        f"submap reinitializations={regression.submap_reinitializations}",
        flush=True,
    )
    print(
        "  loop retrieval funnel: "
        f"eligible={regression.loop_retrieval_eligible} "
        f"shortlisted={regression.loop_retrieval_shortlisted} "
        f"descriptor_rejections={regression.loop_retrieval_descriptor_rejections} "
        "distance bins: "
        f"<=0.05={regression.loop_retrieval_distance_at_most_0_05} "
        f"<=0.10={regression.loop_retrieval_distance_at_most_0_10} "
        f"<=0.15={regression.loop_retrieval_distance_at_most_0_15} "
        f"proposals={regression.loop_retrieval_candidates} "
        f"verified={regression.loop_verified_candidates} "
        f"accepted={regression.loop_accepted_candidates}",
        flush=True,
    )
    print(
        "  frontier funnel: "
        f"raw={regression.raw_frontier_candidates} "
        f"blacklisted={regression.blacklisted_frontier_candidates} "
        f"unreachable={regression.unreachable_candidates}",
        flush=True,
    )
    control_rate, planner_rate = regression.starvation_rates()
    host_healthy = (
        control_rate <= arguments.maximum_control_starvation_per_minute and
        planner_rate <= arguments.maximum_planner_starvation_per_minute
    )
    print(
        "  host health: "
        f"control starvation={regression.control_starvation_warnings} "
        f"({control_rate:.2f}/min) "
        f"planner starvation={regression.planner_starvation_warnings} "
        f"({planner_rate:.2f}/min) "
        f"healthy={'yes' if host_healthy else 'no'}",
        flush=True,
    )
    for name, passed in checks.items():
        print(f"  {'PASS' if passed else 'FAIL'} {name}", flush=True)
    for message in regression.critical_logs:
        print(f"  critical log: {message}", flush=True)
    verdict = classify(checks, host_healthy)
    print(
        f"  VERDICT {['PASS', 'FAIL', 'INFRA_UNSTABLE'][verdict]}",
        flush=True,
    )
    return verdict


def main():
    arguments = parse_arguments(remove_ros_args(sys.argv)[1:])
    rclpy.init()
    regression = ExplorationRegression()
    deadline = time.monotonic() + arguments.wall_timeout
    verdict = FAIL
    interrupted = False
    try:
        while rclpy.ok() and not regression.complete:
            if time.monotonic() >= deadline:
                break
            regression.note_sim_time(
                regression.get_clock().now().nanoseconds * 1.0e-9
            )
            regression.sample_map_frame_pose()
            rclpy.spin_once(regression, timeout_sec=0.2)
        # The completion flag arrives on its own topic and can beat the
        # diagnostics carrying completion_reason. Without this drain the report
        # says reason='none' for every successful run, which is exactly the
        # field needed to tell a finished map from a premature stop.
        drain = time.monotonic() + arguments.completion_drain
        while rclpy.ok() and time.monotonic() < drain and not regression.completion_reason:
            rclpy.spin_once(regression, timeout_sec=0.2)
        verdict = evaluate(regression, arguments)
    except KeyboardInterrupt:
        interrupted = True
    finally:
        regression.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()
    if interrupted:
        return 130
    # PASS/FAIL/INFRA_UNSTABLE keep distinct codes so a campaign runner never
    # has to parse stdout to tell an algorithm regression from a starved host.
    return verdict


if __name__ == "__main__":
    raise SystemExit(main())
