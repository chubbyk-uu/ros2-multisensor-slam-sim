#!/usr/bin/env python3

"""Drive and score the structured 3D RTAB-Map loop regression."""

import argparse
import math
import sys
import time

from action_msgs.msg import GoalStatus
from geometry_msgs.msg import PoseStamped, Twist
from lifecycle_msgs.srv import GetState
from nav2_msgs.action import NavigateToPose
from nav2_msgs.msg import CollisionMonitorState
from nav_msgs.msg import OccupancyGrid, Odometry
from rcl_interfaces.msg import Log
import rclpy
from rclpy.action import ActionClient
from rclpy.node import Node
from rclpy.parameter import Parameter
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from rclpy.utilities import remove_ros_args
from rtabmap_msgs.msg import Info, MapGraph
from tf2_msgs.msg import TFMessage


CRITICAL_LOG_FRAGMENTS = (
    "can only support up to 16 z values",
    "Inconsistent configuration in collision checking",
    "Did not receive data since",
    "Exception caught",
    "process has died",
)


def normalize_angle(angle):
    return math.atan2(math.sin(angle), math.cos(angle))


def yaw_from_quaternion(orientation):
    sin_yaw = 2.0 * (
        orientation.w * orientation.z
        + orientation.x * orientation.y
    )
    cos_yaw = 1.0 - 2.0 * (
        orientation.y * orientation.y
        + orientation.z * orientation.z
    )
    return math.atan2(sin_yaw, cos_yaw)


def pose_from_odometry(message):
    position = message.pose.pose.position
    return (
        position.x,
        position.y,
        yaw_from_quaternion(message.pose.pose.orientation),
    )


def compose_pose(first, second):
    cosine = math.cos(first[2])
    sine = math.sin(first[2])
    return (
        first[0] + cosine * second[0] - sine * second[1],
        first[1] + sine * second[0] + cosine * second[1],
        normalize_angle(first[2] + second[2]),
    )


def relative_pose(start, finish):
    dx = finish[0] - start[0]
    dy = finish[1] - start[1]
    cosine = math.cos(start[2])
    sine = math.sin(start[2])
    return (
        cosine * dx + sine * dy,
        -sine * dx + cosine * dy,
        normalize_angle(finish[2] - start[2]),
    )


def transform_to_pose(transform):
    translation = transform.translation
    return (
        translation.x,
        translation.y,
        yaw_from_quaternion(transform.rotation),
    )


def starting_poses(truth_pose, odom_pose, map_to_odom, drive_only):
    starts = {"truth": truth_pose, "odom": odom_pose}
    if not drive_only:
        starts["slam"] = compose_pose(map_to_odom, odom_pose)
    return starts


class StructuredLoopRegression(Node):
    def __init__(self):
        super().__init__(
            "structured_loop_regression",
            parameter_overrides=[Parameter("use_sim_time", value=True)],
        )
        self.truth_pose = None
        self.odom_pose = None
        self.map_to_odom = None
        self.latest_grid = None
        self.graph_nodes = 0
        self.proximity_events = set()
        self.maximum_map_correction = 0.0
        self.maximum_map_to_odom_height = 0.0
        self.maximum_map_to_odom_tilt = 0.0
        self.truth_distance = 0.0
        self.previous_truth_pose = None
        self.measuring = False
        self.critical_logs = []
        self.ekf_rate_warnings = 0
        self.completed_waypoints = 0
        self.collision_actions = 0
        self.last_collision_action = CollisionMonitorState.DO_NOTHING
        self.navigation_segment = None
        self.portal_crossing_error = math.inf
        self.portal_crossing_x = math.nan
        self.minimum_mushroom_distance = math.inf
        self.maximum_mushroom_detour = 0.0

        self.command_publisher = self.create_publisher(Twist, "/cmd_vel", 10)
        self.create_subscription(
            Odometry,
            "/ground_truth/odom",
            self._truth_callback,
            50,
        )
        self.create_subscription(Odometry, "/odom", self._odom_callback, 50)
        self.create_subscription(Info, "/rtabmap/info", self._info_callback, 20)
        self.create_subscription(
            MapGraph,
            "/rtabmap/mapGraph",
            self._graph_callback,
            10,
        )
        self.create_subscription(TFMessage, "/tf", self._tf_callback, 100)
        map_qos = QoSProfile(
            depth=1,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
        )
        self.create_subscription(
            OccupancyGrid,
            "/rtabmap/map",
            self._map_callback,
            map_qos,
        )
        self.create_subscription(Log, "/rosout", self._log_callback, 200)
        self.create_subscription(
            CollisionMonitorState,
            "/collision_monitor_state",
            self._collision_callback,
            10,
        )
        self.navigation_client = ActionClient(
            self,
            NavigateToPose,
            "/navigate_to_pose",
        )

    def _truth_callback(self, message):
        pose = pose_from_odometry(message)
        if self.measuring and self.previous_truth_pose is not None:
            step = math.hypot(
                pose[0] - self.previous_truth_pose[0],
                pose[1] - self.previous_truth_pose[1],
            )
            if step < 0.25:
                self.truth_distance += step
        self.previous_truth_pose = pose
        self.truth_pose = pose
        if self.navigation_segment == "portal":
            crossing_error = abs(pose[1] - 3.0)
            if crossing_error < self.portal_crossing_error:
                self.portal_crossing_error = crossing_error
                self.portal_crossing_x = pose[0]
        elif self.navigation_segment == "mushroom":
            distance = math.hypot(pose[0] - 8.5, pose[1] - 12.85)
            self.minimum_mushroom_distance = min(
                self.minimum_mushroom_distance,
                distance,
            )
            self.maximum_mushroom_detour = max(
                self.maximum_mushroom_detour,
                12.55 - pose[1],
            )

    def _odom_callback(self, message):
        self.odom_pose = pose_from_odometry(message)

    def _info_callback(self, message):
        if message.proximity_detection_id > 0:
            event = (message.ref_id, message.proximity_detection_id)
            if event not in self.proximity_events:
                self.proximity_events.add(event)
                print(
                    "  proximity constraint: "
                    f"{message.proximity_detection_id} -> {message.ref_id}",
                    flush=True,
                )

    def _graph_callback(self, message):
        self.graph_nodes = max(self.graph_nodes, len(message.poses_id))

    def _tf_callback(self, message):
        for transform in message.transforms:
            if (
                transform.header.frame_id == "map"
                and transform.child_frame_id == "odom"
            ):
                self.map_to_odom = transform_to_pose(transform.transform)
                correction = math.hypot(
                    self.map_to_odom[0],
                    self.map_to_odom[1],
                )
                self.maximum_map_correction = max(
                    self.maximum_map_correction,
                    correction,
                )
                rotation = transform.transform.rotation
                sin_roll = 2.0 * (
                    rotation.w * rotation.x
                    + rotation.y * rotation.z
                )
                cos_roll = 1.0 - 2.0 * (
                    rotation.x * rotation.x
                    + rotation.y * rotation.y
                )
                roll = math.atan2(sin_roll, cos_roll)
                sin_pitch = 2.0 * (
                    rotation.w * rotation.y
                    - rotation.z * rotation.x
                )
                pitch = math.asin(max(-1.0, min(1.0, sin_pitch)))
                self.maximum_map_to_odom_height = max(
                    self.maximum_map_to_odom_height,
                    abs(transform.transform.translation.z),
                )
                self.maximum_map_to_odom_tilt = max(
                    self.maximum_map_to_odom_tilt,
                    abs(roll),
                    abs(pitch),
                )

    def _map_callback(self, message):
        self.latest_grid = message

    def _log_callback(self, message):
        if "Failed to meet update rate" in message.msg:
            self.ekf_rate_warnings += 1
        if any(fragment in message.msg for fragment in CRITICAL_LOG_FRAGMENTS):
            if message.msg not in self.critical_logs:
                self.critical_logs.append(message.msg)

    def _collision_callback(self, message):
        if (
            message.action_type != CollisionMonitorState.DO_NOTHING
            and message.action_type != self.last_collision_action
        ):
            self.collision_actions += 1
        self.last_collision_action = message.action_type

    def spin_once(self, timeout_sec=0.025):
        rclpy.spin_once(self, timeout_sec=timeout_sec)

    def simulation_time(self):
        return self.get_clock().now().nanoseconds * 1.0e-9

    def publish_command(self, linear=0.0, angular=0.0):
        message = Twist()
        message.linear.x = linear
        message.angular.z = angular
        self.command_publisher.publish(message)

    def stop(self):
        for _ in range(5):
            self.publish_command()
            self.spin_once(0.02)

    def wait_for_inputs(self, timeout, require_rtabmap=True):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            self.spin_once(0.1)
            if self.truth_pose is not None and self.odom_pose is not None and (
                self.map_to_odom is not None or not require_rtabmap
            ):
                return
        required = "truth and odometry"
        if require_rtabmap:
            required += " and RTAB-Map graph"
        raise RuntimeError(f"timed out waiting for {required}")

    def settle(self, duration):
        started = self.simulation_time()
        wall_deadline = time.monotonic() + max(30.0, duration * 5.0)
        while self.simulation_time() - started < duration:
            if time.monotonic() >= wall_deadline:
                raise RuntimeError("initial settle timed out")
            self.publish_command()
            self.spin_once()

    def rotate_to(self, desired_yaw, arguments, label):
        wall_deadline = time.monotonic() + arguments.segment_wall_timeout
        while True:
            error = normalize_angle(desired_yaw - self.truth_pose[2])
            if abs(error) <= math.radians(arguments.heading_tolerance_degrees):
                break
            if time.monotonic() >= wall_deadline:
                raise RuntimeError(f"{label} rotation timed out")
            angular = max(
                -arguments.maximum_angular_speed,
                min(
                    arguments.maximum_angular_speed,
                    arguments.heading_control_gain * error,
                ),
            )
            self.publish_command(0.0, angular)
            self.spin_once()
        self.stop()

    def drive_to(self, target, arguments, label):
        initial_distance = math.hypot(
            target[0] - self.truth_pose[0],
            target[1] - self.truth_pose[1],
        )
        next_report = arguments.report_interval
        wall_deadline = time.monotonic() + arguments.segment_wall_timeout
        while True:
            dx = target[0] - self.truth_pose[0]
            dy = target[1] - self.truth_pose[1]
            distance = math.hypot(dx, dy)
            if distance <= arguments.position_tolerance:
                break
            if time.monotonic() >= wall_deadline:
                raise RuntimeError(f"{label} traversal timed out")
            desired_yaw = math.atan2(dy, dx)
            heading_error = normalize_angle(desired_yaw - self.truth_pose[2])
            angular = max(
                -arguments.maximum_angular_speed,
                min(
                    arguments.maximum_angular_speed,
                    arguments.heading_control_gain * heading_error,
                ),
            )
            linear = min(arguments.linear_speed, max(0.08, distance))
            linear *= max(0.0, math.cos(heading_error))
            self.publish_command(linear, angular)
            self.spin_once()

            progress = initial_distance - distance
            if progress >= next_report:
                print(
                    f"  {label}: {progress:.1f}/{initial_distance:.1f} m, "
                    f"nodes={self.graph_nodes}, "
                    f"proximity={len(self.proximity_events)}",
                    flush=True,
                )
                next_report += arguments.report_interval
        self.stop()
        self.completed_waypoints += 1

    def build_route(self, laps):
        lap = ((24.0, 0.0), (24.0, 12.0), (0.0, 12.0), (0.0, 0.0))
        return list(lap) * laps

    def map_pose(self):
        return compose_pose(self.map_to_odom, self.odom_pose)

    def wait_for_navigation(self, timeout):
        deadline = time.monotonic() + timeout
        state_client = self.create_client(GetState, "/bt_navigator/get_state")
        while time.monotonic() < deadline:
            remaining = deadline - time.monotonic()
            if not state_client.wait_for_service(timeout_sec=min(0.5, remaining)):
                continue
            future = state_client.call_async(GetState.Request())
            while not future.done() and time.monotonic() < deadline:
                self.spin_once(0.1)
            if (
                future.done()
                and future.result() is not None
                and future.result().current_state.label == "active"
                and self.navigation_client.wait_for_server(timeout_sec=0.5)
            ):
                return
        raise RuntimeError("Nav2 did not become active before the timeout")

    def navigation_pose(self, x, y, yaw):
        pose = PoseStamped()
        pose.header.frame_id = "map"
        pose.header.stamp = self.get_clock().now().to_msg()
        pose.pose.position.x = x
        pose.pose.position.y = y
        pose.pose.orientation.z = math.sin(yaw / 2.0)
        pose.pose.orientation.w = math.cos(yaw / 2.0)
        return pose

    def navigate_to(self, target, arguments, label, segment=None):
        goal = NavigateToPose.Goal()
        goal.pose = self.navigation_pose(*target)
        send_future = self.navigation_client.send_goal_async(goal)
        wall_deadline = time.monotonic() + arguments.navigation_wall_timeout
        while not send_future.done() and time.monotonic() < wall_deadline:
            self.spin_once(0.1)
        if not send_future.done() or send_future.result() is None:
            raise RuntimeError(f"{label} goal request timed out")
        goal_handle = send_future.result()
        if not goal_handle.accepted:
            raise RuntimeError(f"{label} goal was rejected")

        self.navigation_segment = segment
        result_future = goal_handle.get_result_async()
        next_report = time.monotonic()
        while not result_future.done():
            if time.monotonic() >= wall_deadline:
                goal_handle.cancel_goal_async()
                self.navigation_segment = None
                raise RuntimeError(f"{label} navigation timed out")
            if time.monotonic() >= next_report:
                print(
                    f"  {label}: truth=({self.truth_pose[0]:.2f}, "
                    f"{self.truth_pose[1]:.2f})",
                    flush=True,
                )
                next_report = time.monotonic() + 5.0
            self.spin_once(0.1)
        self.navigation_segment = None

        wrapped_result = result_future.result()
        if (
            wrapped_result is None
            or wrapped_result.status != GoalStatus.STATUS_SUCCEEDED
        ):
            status = "missing" if wrapped_result is None else wrapped_result.status
            raise RuntimeError(f"{label} failed with action status {status}")
        goal_error = math.hypot(
            self.map_pose()[0] - target[0],
            self.map_pose()[1] - target[1],
        )
        print(f"  {label}: reached, map-frame error={goal_error:.3f} m", flush=True)
        return goal_error

    def grid_values_near(self, x, y, minimum_radius, maximum_radius):
        grid = self.latest_grid
        origin = grid.info.origin.position
        resolution = grid.info.resolution
        radius_cells = math.ceil(maximum_radius / resolution)
        center_x = round((x - origin.x) / resolution)
        center_y = round((y - origin.y) / resolution)
        values = []
        for row in range(center_y - radius_cells, center_y + radius_cells + 1):
            if row < 0 or row >= grid.info.height:
                continue
            for column in range(
                center_x - radius_cells,
                center_x + radius_cells + 1,
            ):
                if column < 0 or column >= grid.info.width:
                    continue
                cell_x = origin.x + (column + 0.5) * resolution
                cell_y = origin.y + (row + 0.5) * resolution
                distance = math.hypot(cell_x - x, cell_y - y)
                if minimum_radius <= distance <= maximum_radius:
                    values.append(grid.data[row * grid.info.width + column])
        return values

    def run_navigation_acceptance(self, arguments):
        self.wait_for_navigation(arguments.navigation_activation_timeout)
        route = (
            ((23.9, 1.8, math.pi / 2.0), "portal approach", None),
            ((23.9, 4.2, math.pi / 2.0), "portal traversal", "portal"),
            ((23.9, 11.8, math.pi / 2.0), "north approach", None),
            ((9.6, 12.55, math.pi), "mushroom approach", None),
            ((7.6, 12.55, math.pi), "mushroom traversal", "mushroom"),
        )
        goal_errors = []
        print("Starting RTAB-Map + Nav2 height-aware acceptance", flush=True)
        for target, label, segment in route:
            goal_errors.append(
                self.navigate_to(target, arguments, label, segment)
            )
        self.settle(2.0)

        cap_values = self.grid_values_near(8.5, 12.85, 0.25, 0.48)
        portal_values = self.grid_values_near(24.0, 3.0, 0.0, 0.12)
        checks = {
            "all_navigation_goals_reached": len(goal_errors) == len(route),
            "navigation_goal_error_bounded": (
                max(goal_errors) <= arguments.maximum_navigation_goal_error
            ),
            "high_portal_crossed": self.portal_crossing_error <= 0.15,
            "portal_opening_used": 23.05 <= self.portal_crossing_x <= 24.95,
            "mushroom_cap_projected": bool(
                cap_values and max(cap_values) >= 50
            ),
            "portal_centre_remains_free": bool(
                portal_values and min(portal_values) == 0
            ),
            "mushroom_outline_avoided": (
                self.minimum_mushroom_distance
                >= arguments.minimum_mushroom_clearance
            ),
            "mushroom_forced_detour": (
                self.maximum_mushroom_detour
                >= arguments.minimum_mushroom_detour
            ),
        }

        print("\nheight-aware navigation acceptance result")
        print(
            f"portal      : crossing error={self.portal_crossing_error:.3f} m, "
            f"x={self.portal_crossing_x:.3f} m"
        )
        print(
            f"mushroom    : minimum centre distance="
            f"{self.minimum_mushroom_distance:.3f} m, "
            f"detour={self.maximum_mushroom_detour:.3f} m"
        )
        print(
            f"costmap     : cap peak={max(cap_values) if cap_values else 'none'}, "
            f"portal minimum={min(portal_values) if portal_values else 'none'}"
        )
        print(
            f"runtime     : collision monitor transitions="
            f"{self.collision_actions}"
        )
        for name, passed in checks.items():
            print(f"  [{'PASS' if passed else 'FAIL'}] {name}")
        return all(checks.values())

    def evaluate(self, arguments, starts, route):
        truth_motion = relative_pose(starts["truth"], self.truth_pose)
        odom_motion = relative_pose(starts["odom"], self.odom_pose)
        slam_motion = relative_pose(starts["slam"], self.map_pose())
        truth_closure = math.hypot(truth_motion[0], truth_motion[1])
        odom_error = math.hypot(
            odom_motion[0] - truth_motion[0],
            odom_motion[1] - truth_motion[1],
        )
        slam_error = math.hypot(
            slam_motion[0] - truth_motion[0],
            slam_motion[1] - truth_motion[1],
        )
        slam_yaw_error = abs(normalize_angle(slam_motion[2] - truth_motion[2]))

        grid = self.latest_grid
        map_width = grid.info.width * grid.info.resolution
        map_height = grid.info.height * grid.info.resolution
        known_cells = sum(value >= 0 for value in grid.data)
        free_cells = sum(value == 0 for value in grid.data)
        occupied_cells = sum(value >= 50 for value in grid.data)

        checks = {
            "all_waypoints_reached": self.completed_waypoints == len(route),
            "route_distance_reached": (
                self.truth_distance >= arguments.minimum_route_distance
            ),
            "truth_route_closed": truth_closure <= arguments.maximum_truth_closure,
            "rtabmap_graph_large_enough": (
                self.graph_nodes >= arguments.minimum_graph_nodes
            ),
            "proximity_loop_detected": (
                len(self.proximity_events) >= arguments.minimum_proximity_events
            ),
            "map_to_odom_correction_observed": (
                self.maximum_map_correction
                >= arguments.minimum_map_correction
            ),
            "map_to_odom_height_is_planar": (
                self.maximum_map_to_odom_height
                <= arguments.maximum_map_to_odom_height
            ),
            "map_to_odom_tilt_is_planar": (
                self.maximum_map_to_odom_tilt
                <= math.radians(arguments.maximum_map_to_odom_tilt_degrees)
            ),
            "slam_translation_error_bounded": (
                slam_error <= arguments.maximum_slam_translation_error
            ),
            "slam_yaw_error_bounded": (
                slam_yaw_error
                <= math.radians(arguments.maximum_slam_yaw_error_degrees)
            ),
            "map_width_bounded": (
                arguments.minimum_map_width <= map_width
                <= arguments.maximum_map_width
            ),
            "map_height_bounded": (
                arguments.minimum_map_height <= map_height
                <= arguments.maximum_map_height
            ),
            "map_has_known_space": known_cells >= arguments.minimum_known_cells,
            "map_has_free_space": free_cells >= arguments.minimum_free_cells,
            "map_has_obstacles": (
                occupied_cells >= arguments.minimum_occupied_cells
            ),
            "no_critical_runtime_logs": not self.critical_logs,
            "ekf_rate_warnings_bounded": (
                self.ekf_rate_warnings <= arguments.maximum_ekf_rate_warnings
            ),
        }

        print("\nstructured 3D loop regression result")
        print(
            f"route       : {self.truth_distance:.1f} m, "
            f"waypoints={self.completed_waypoints}/{len(route)}"
        )
        print(
            f"closure     : truth={truth_closure:.3f} m, "
            f"odom error={odom_error:.3f} m, SLAM error={slam_error:.3f} m / "
            f"{math.degrees(slam_yaw_error):.3f} deg"
        )
        print(
            f"graph       : nodes={self.graph_nodes}, "
            f"proximity={len(self.proximity_events)}, "
            f"map correction peak={self.maximum_map_correction:.3f} m"
        )
        print(
            f"map plane   : z peak={self.maximum_map_to_odom_height:.4f} m, "
            f"tilt peak={math.degrees(self.maximum_map_to_odom_tilt):.3f} deg"
        )
        print(
            f"map         : {map_width:.2f} x {map_height:.2f} m, "
            f"known/free/occupied={known_cells}/{free_cells}/{occupied_cells}"
        )
        print(f"runtime     : EKF rate warnings={self.ekf_rate_warnings}")
        for name, passed in checks.items():
            print(f"  [{'PASS' if passed else 'FAIL'}] {name}")
        if self.critical_logs:
            print("critical runtime logs:")
            for message in self.critical_logs:
                print(f"  - {message}")
        return all(checks.values())

    def run(self, arguments):
        self.wait_for_inputs(
            arguments.startup_timeout,
            require_rtabmap=not arguments.drive_only,
        )
        self.settle(arguments.initial_settle_time)
        starts = starting_poses(
            self.truth_pose,
            self.odom_pose,
            self.map_to_odom,
            arguments.drive_only,
        )
        self.previous_truth_pose = self.truth_pose
        self.measuring = True
        route = self.build_route(arguments.laps)

        print(
            f"Driving {arguments.laps} structured-loop lap(s), "
            f"{len(route)} waypoints",
            flush=True,
        )
        for index, target in enumerate(route, start=1):
            desired_yaw = math.atan2(
                target[1] - self.truth_pose[1],
                target[0] - self.truth_pose[0],
            )
            label = f"waypoint {index}/{len(route)}"
            self.rotate_to(desired_yaw, arguments, label)
            self.drive_to(target, arguments, label)

        self.stop()
        self.settle(arguments.final_settle_time)
        if arguments.drive_only:
            print(
                "PASS: structured route recording drive completed: "
                f"distance={self.truth_distance:.1f} m, "
                f"waypoints={self.completed_waypoints}/{len(route)}",
                flush=True,
            )
            return True
        if self.latest_grid is None:
            raise RuntimeError("RTAB-Map did not publish /rtabmap/map")
        mapping_passed = self.evaluate(arguments, starts, route)
        if not arguments.navigation_acceptance:
            return mapping_passed
        navigation_passed = self.run_navigation_acceptance(arguments)
        return mapping_passed and navigation_passed


def parse_arguments(argv):
    parser = argparse.ArgumentParser()
    parser.add_argument("--laps", type=int, default=2)
    parser.add_argument(
        "--drive-only",
        action="store_true",
        help="Drive the truth-referenced route without requiring SLAM outputs.",
    )
    parser.add_argument("--startup-timeout", type=float, default=60.0)
    parser.add_argument("--initial-settle-time", type=float, default=5.0)
    parser.add_argument("--final-settle-time", type=float, default=8.0)
    parser.add_argument("--linear-speed", type=float, default=0.45)
    parser.add_argument("--maximum-angular-speed", type=float, default=0.7)
    parser.add_argument("--heading-control-gain", type=float, default=1.8)
    parser.add_argument("--heading-tolerance-degrees", type=float, default=2.0)
    parser.add_argument("--position-tolerance", type=float, default=0.12)
    parser.add_argument("--segment-wall-timeout", type=float, default=180.0)
    parser.add_argument("--report-interval", type=float, default=5.0)
    parser.add_argument("--minimum-route-distance", type=float, default=138.0)
    parser.add_argument("--maximum-truth-closure", type=float, default=0.25)
    parser.add_argument("--minimum-graph-nodes", type=int, default=300)
    parser.add_argument("--minimum-proximity-events", type=int, default=1)
    parser.add_argument("--minimum-map-correction", type=float, default=0.02)
    parser.add_argument("--maximum-map-to-odom-height", type=float, default=0.02)
    parser.add_argument(
        "--maximum-map-to-odom-tilt-degrees", type=float, default=0.5
    )
    parser.add_argument(
        "--maximum-slam-translation-error", type=float, default=0.35
    )
    parser.add_argument(
        "--maximum-slam-yaw-error-degrees", type=float, default=5.0
    )
    parser.add_argument("--minimum-map-width", type=float, default=26.0)
    parser.add_argument("--maximum-map-width", type=float, default=31.0)
    parser.add_argument("--minimum-map-height", type=float, default=14.0)
    parser.add_argument("--maximum-map-height", type=float, default=19.0)
    parser.add_argument("--minimum-known-cells", type=int, default=30000)
    parser.add_argument("--minimum-free-cells", type=int, default=25000)
    parser.add_argument("--minimum-occupied-cells", type=int, default=1500)
    parser.add_argument("--maximum-ekf-rate-warnings", type=int, default=3)
    parser.add_argument("--navigation-acceptance", action="store_true")
    parser.add_argument("--navigation-activation-timeout", type=float, default=120.0)
    parser.add_argument("--navigation-wall-timeout", type=float, default=300.0)
    parser.add_argument("--maximum-navigation-goal-error", type=float, default=0.40)
    parser.add_argument("--minimum-mushroom-clearance", type=float, default=0.55)
    parser.add_argument("--minimum-mushroom-detour", type=float, default=0.25)
    arguments = parser.parse_args(argv)
    if arguments.laps < 1:
        parser.error("--laps must be at least 1")
    return arguments


def main(argv=None):
    raw_arguments = sys.argv if argv is None else [sys.argv[0], *argv]
    arguments = parse_arguments(remove_ros_args(args=raw_arguments)[1:])
    rclpy.init(args=raw_arguments)
    node = StructuredLoopRegression()
    try:
        passed = node.run(arguments)
        return 0 if passed else 1
    except Exception as error:  # noqa: B902 - process boundary reports failures.
        node.get_logger().error(str(error))
        return 2
    finally:
        node.stop()
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    raise SystemExit(main())
