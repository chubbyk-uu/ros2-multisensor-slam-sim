#!/usr/bin/env python3

import math
import time

from nav_msgs.msg import OccupancyGrid
import rclpy
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, HistoryPolicy, QoSProfile, ReliabilityPolicy


def validate_grid_metadata(
    frame_id,
    resolution,
    width,
    height,
    data,
    expected_frame,
    minimum_width,
    minimum_height,
    minimum_known_cells,
    minimum_free_cells,
    minimum_occupied_cells,
    expected_resolution,
    resolution_tolerance,
    minimum_metric_width,
    maximum_metric_width,
    minimum_metric_height,
    maximum_metric_height,
):
    """Validate that an occupancy grid is usable as a navigation candidate."""
    errors = []
    if expected_frame and frame_id != expected_frame:
        errors.append(f"frame_id is {frame_id!r}, expected {expected_frame!r}")
    if not math.isfinite(resolution) or resolution <= 0.0:
        errors.append("resolution must be finite and positive")
    elif (
        expected_resolution > 0.0
        and abs(resolution - expected_resolution) > resolution_tolerance
    ):
        errors.append(
            f"resolution is {resolution:.6f}, expected "
            f"{expected_resolution:.6f} +/- {resolution_tolerance:.6f}"
        )
    if width < minimum_width or height < minimum_height:
        errors.append(
            "grid dimensions are too small: "
            f"{width}x{height}, expected at least "
            f"{minimum_width}x{minimum_height}"
        )
    expected_size = width * height
    if len(data) != expected_size:
        errors.append(
            f"data length is {len(data)}, expected width * height ({expected_size})"
        )

    known_cells = sum(value >= 0 for value in data)
    free_cells = sum(value == 0 for value in data)
    occupied_cells = sum(value >= 50 for value in data)
    if known_cells < minimum_known_cells:
        errors.append(
            f"known cells are too few: {known_cells}, expected at least "
            f"{minimum_known_cells}"
        )
    if free_cells < minimum_free_cells:
        errors.append(
            f"free cells are too few: {free_cells}, expected at least "
            f"{minimum_free_cells}"
        )
    if occupied_cells < minimum_occupied_cells:
        errors.append(
            f"occupied cells are too few: {occupied_cells}, expected at least "
            f"{minimum_occupied_cells}"
        )

    if math.isfinite(resolution) and resolution > 0.0:
        metric_width = width * resolution
        metric_height = height * resolution
        if minimum_metric_width > 0.0 and metric_width < minimum_metric_width:
            errors.append(
                f"metric width is {metric_width:.3f} m, expected at least "
                f"{minimum_metric_width:.3f} m"
            )
        if maximum_metric_width > 0.0 and metric_width > maximum_metric_width:
            errors.append(
                f"metric width is {metric_width:.3f} m, expected at most "
                f"{maximum_metric_width:.3f} m"
            )
        if minimum_metric_height > 0.0 and metric_height < minimum_metric_height:
            errors.append(
                f"metric height is {metric_height:.3f} m, expected at least "
                f"{minimum_metric_height:.3f} m"
            )
        if maximum_metric_height > 0.0 and metric_height > maximum_metric_height:
            errors.append(
                f"metric height is {metric_height:.3f} m, expected at most "
                f"{maximum_metric_height:.3f} m"
            )

    return errors, {
        "known_cells": known_cells,
        "free_cells": free_cells,
        "occupied_cells": occupied_cells,
    }


class GridContractChecker(Node):
    def __init__(self):
        super().__init__("grid_contract_check")
        self.declare_parameter("topic", "/rtabmap/map")
        self.declare_parameter("expected_frame", "map")
        self.declare_parameter("minimum_width", 20)
        self.declare_parameter("minimum_height", 20)
        self.declare_parameter("minimum_known_cells", 20)
        self.declare_parameter("minimum_free_cells", 1)
        self.declare_parameter("minimum_occupied_cells", 1)
        self.declare_parameter("expected_resolution", 0.05)
        self.declare_parameter("resolution_tolerance", 0.001)
        self.declare_parameter("minimum_metric_width", 0.0)
        self.declare_parameter("maximum_metric_width", 0.0)
        self.declare_parameter("minimum_metric_height", 0.0)
        self.declare_parameter("maximum_metric_height", 0.0)
        self.declare_parameter("timeout_sec", 20.0)

        self.topic = self.get_parameter("topic").value
        self.expected_frame = self.get_parameter("expected_frame").value
        self.minimum_width = self.get_parameter("minimum_width").value
        self.minimum_height = self.get_parameter("minimum_height").value
        self.minimum_known_cells = self.get_parameter("minimum_known_cells").value
        self.minimum_free_cells = self.get_parameter("minimum_free_cells").value
        self.minimum_occupied_cells = self.get_parameter(
            "minimum_occupied_cells"
        ).value
        self.expected_resolution = self.get_parameter("expected_resolution").value
        self.resolution_tolerance = self.get_parameter(
            "resolution_tolerance"
        ).value
        self.minimum_metric_width = self.get_parameter(
            "minimum_metric_width"
        ).value
        self.maximum_metric_width = self.get_parameter(
            "maximum_metric_width"
        ).value
        self.minimum_metric_height = self.get_parameter(
            "minimum_metric_height"
        ).value
        self.maximum_metric_height = self.get_parameter(
            "maximum_metric_height"
        ).value
        self.timeout_sec = self.get_parameter("timeout_sec").value
        self.result = None
        qos = QoSProfile(
            depth=1,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
            history=HistoryPolicy.KEEP_LAST,
            reliability=ReliabilityPolicy.RELIABLE,
        )
        self.subscription = self.create_subscription(
            OccupancyGrid, self.topic, self._grid_callback, qos
        )
        self.get_logger().info(
            f"Waiting up to {self.timeout_sec:.1f} s for {self.topic}"
        )

    def _grid_callback(self, message):
        errors, counts = validate_grid_metadata(
            frame_id=message.header.frame_id,
            resolution=message.info.resolution,
            width=message.info.width,
            height=message.info.height,
            data=message.data,
            expected_frame=self.expected_frame,
            minimum_width=self.minimum_width,
            minimum_height=self.minimum_height,
            minimum_known_cells=self.minimum_known_cells,
            minimum_free_cells=self.minimum_free_cells,
            minimum_occupied_cells=self.minimum_occupied_cells,
            expected_resolution=self.expected_resolution,
            resolution_tolerance=self.resolution_tolerance,
            minimum_metric_width=self.minimum_metric_width,
            maximum_metric_width=self.maximum_metric_width,
            minimum_metric_height=self.minimum_metric_height,
            maximum_metric_height=self.maximum_metric_height,
        )
        if errors:
            for error in errors:
                self.get_logger().error(error)
            self.result = 2
        else:
            self.get_logger().info(
                "OccupancyGrid contract passed: "
                f"frame={message.header.frame_id}, "
                f"size={message.info.width}x{message.info.height}, "
                f"resolution={message.info.resolution:.3f} m/cell, "
                f"known={counts['known_cells']}, free={counts['free_cells']}, "
                f"occupied={counts['occupied_cells']}"
            )
            self.result = 0
        self.destroy_subscription(self.subscription)


def main(args=None):
    rclpy.init(args=args)
    node = GridContractChecker()
    deadline = time.monotonic() + node.timeout_sec
    try:
        while rclpy.ok() and node.result is None:
            if time.monotonic() >= deadline:
                node.get_logger().error(
                    f"Timed out waiting for OccupancyGrid on {node.topic}"
                )
                node.result = 3
                break
            rclpy.spin_once(node, timeout_sec=0.1)
        return node.result if node.result is not None else 4
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    raise SystemExit(main())
