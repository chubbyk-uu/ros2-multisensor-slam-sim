#!/usr/bin/env python3

"""Run the frontier exploration regression N times and judge the batch.

A single run cannot validate an intermittent failure. The pre-fix entry point
measured five passes in eight runs, so one pass carries roughly a 62% prior and
does not distinguish a fix from luck. This runner exists so the acceptance rule
is written down before the numbers arrive, rather than chosen to fit them.

It also keeps the host out of the way: runs are serial and headless, leftover
simulator processes are refused rather than tolerated, and a simulator that
crashes while shutting down is recorded separately from the verdict it produced.
"""

import argparse
import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

from ament_index_python.packages import PackageNotFoundError
from ament_index_python.packages import get_package_share_directory

PASS = 0
FAIL = 1
INFRA_UNSTABLE = 2
VERDICT_NAMES = {PASS: "PASS", FAIL: "FAIL", INFRA_UNSTABLE: "INFRA_UNSTABLE"}

# Anything here means a previous run is still alive. Starting anyway would let
# two simulators share the machine, which is the very condition this campaign
# is trying to keep out of its measurements.
LEFTOVER_PROCESS_PATTERNS = (
    "gz sim",
    "frontier_explorer_node",
    "scan_to_map_odometry_node",
    "bt_navigator",
    "controller_server",
    "planner_server",
)

# ros2 launch prefixes every captured line with the node name, so these must
# tolerate arbitrary leading text rather than anchoring at the line start.
VERDICT_PATTERN = re.compile(r"VERDICT (PASS|FAIL|INFRA_UNSTABLE)\s*$", re.M)
FAILED_CHECK_PATTERN = re.compile(r"(?:^|\s)FAIL ([a-z_]+)\s*$", re.M)
GAZEBO_CRASH_PATTERN = re.compile(
    r"\[gazebo-\d+\]: process has died.*exit code -?\d+"
)

# Pulled into the summary so a batch can be re-read without the logs and
# without hand transcription. Documented run tables were previously copied out
# by eye, which is neither checkable nor reproducible.
MEASUREMENT_PATTERNS = {
    "free_cells": r"free cells:.*?maximum=(\d+)",
    "known_bbox_width_m": r"maximum known width=([0-9.]+) m",
    "known_bbox_height_m": r"maximum known width=[0-9.]+ m height=([0-9.]+)",
    "control_starvation_per_minute": r"control starvation=\d+ \(([0-9.]+)/min\)",
    "planner_starvation_per_minute": r"planner starvation=\d+ \(([0-9.]+)/min\)",
    "successful_goals": r"goals: succeeded=(\d+)",
    "failed_goals": r"goals: succeeded=\d+ failed=(\d+)",
    "truth_distance_m": r"truth distance=([0-9.]+)",
    "pose_graph_commits": r"pose graph: commits=(\d+)",
    "submap_reinitializations": r"submap reinitializations=(\d+)",
    "loop_accepted_candidates": r"proposals=\d+ verified=\d+ accepted=(\d+)",
    "completion_wall_s": r"completion: reason=.*? wall=([0-9.]+)",
    "front_end_peak_position_error_m":
        r"front end error:.*?peak=([0-9.]+) m",
    "front_end_peak_yaw_error_deg":
        r"front end error:.*?yaw peak=([0-9.]+) deg",
    "map_frame_peak_position_error_m":
        r"map frame error:.*?peak=([0-9.]+) m",
    "map_frame_peak_yaw_error_deg":
        r"map frame error:.*?yaw peak=([0-9.]+) deg",
}
HOST_HEALTHY_PATTERN = re.compile(r"healthy=(yes|no)")
# Carried into the summary so a batch says which dependency failed, not just
# that something did. The closed vocabulary is the explorer's; matching the
# codes rather than the prose keeps a reworded message from silently dropping
# the attribution.
EXPLORATION_FAULT_PATTERN = re.compile(
    r"exploration fault: class=(\w+) code=(\w+)")
WALL_OVERSHOOT_PATTERN = re.compile(
    r"west=([0-9.]+) m south=([0-9.]+) m east=([0-9.]+) m north=([0-9.]+) m")


def launch_command(arguments, spawn=None):
    """Build the launch invocation, including any operator overrides.

    Overrides exist so a batch can vary one thing without editing the launch
    file it is measuring: the seed a regression pins for reproducibility is
    exactly the kind of value a campaign may want to sweep instead.
    """
    command = [
        "ros2", "launch", "slam_robot_slam_3d", arguments.launch_file,
        "gui:=false", "rviz:=false",
    ]
    if arguments.world:
        command.extend([
            f"world:={arguments.world}",
            f"world_profile:={arguments.world_profile}",
        ])
    if spawn is not None:
        command.extend([
            f"spawn_x:={spawn['x']}",
            f"spawn_y:={spawn['y']}",
            f"spawn_yaw:={spawn['yaw']}",
        ])
    for override in arguments.launch_argument:
        if ":=" not in override:
            raise ValueError(
                f"launch argument {override!r} must be written name:=value")
        command.append(override)
    return command


# Anything below this omits values a spawn record cannot be replayed without:
# schema 2 added the sampling parameters and bounds, schema 3 the non-static
# policy and the parsed geometry counts, schema 4 the traversable step that
# decides which surfaces count as floor. Refusing beats recording evidence that
# will not survive the first question asked of it -- accepting an older record
# would keep letting incomplete-but-plausible evidence into the repository,
# which is the thing this whole mechanism exists to stop.
MINIMUM_SPAWN_SCHEMA_VERSION = 4


def portable_world_path(path):
    """
    Describe the world without naming this machine.

    The SHA256 already identifies the contents, so the path is only a locating
    hint -- and an absolute one is a bad hint: it points into somebody's home
    directory, or worse into install/, which is a build artefact that does not
    exist anywhere else. Prefer package://, fall back to the bare file name.
    """
    if not path:
        return None
    # Absolute but *not* resolved. Under --symlink-install the installed
    # worlds/ directory is a link into the source tree, so resolving the file
    # first walks straight out of the share directory and nothing matches.
    given = Path(path).absolute()
    parts = given.parts
    for index in range(len(parts) - 2, 0, -1):
        if parts[index] != "share":
            continue
        package = parts[index + 1]
        try:
            share = get_package_share_directory(package)
        except (PackageNotFoundError, ValueError):
            continue
        # Only the candidate prefix is resolved, on both sides, so a symlinked
        # install still recognises its own package.
        if Path(share).resolve() == Path(*parts[:index + 2]).resolve():
            return f"package://{package}/" + "/".join(parts[index + 2:])
    return given.name


def source_revision():
    """Record which source tree produced this batch.

    A clue, not a proof. The C++ nodes run from install/, built at some earlier
    time, so a clean tree does not establish that the running binaries were
    compiled from this commit. It still narrows a later investigation from the
    whole history down to one commit plus whatever the dirty flag admits.
    """
    def git(*command):
        try:
            completed = subprocess.run(
                ("git",) + command, capture_output=True, text=True, check=True,
                cwd=Path(__file__).resolve().parent)
        except (OSError, subprocess.SubprocessError):
            return None
        return completed.stdout.strip()

    commit = git("rev-parse", "HEAD")
    status = None if commit is None else git("status", "--porcelain")
    return {
        "commit": commit,
        "dirty": None if status is None else bool(status),
    }


def sample_spawns(arguments):
    if not arguments.random_spawn:
        return [None] * arguments.runs, None
    if not arguments.world:
        raise ValueError("--world is required with --random-spawn")
    command = [
        "ros2", "run", "slam_robot_gazebo", "safe_spawn_sampler",
        "--world", arguments.world,
        "--count", str(arguments.runs),
        "--seed", str(arguments.campaign_seed),
        "--safety-margin", str(arguments.spawn_safety_margin),
        "--robot-height", str(arguments.spawn_robot_height),
        "--vertical-margin", str(arguments.spawn_vertical_margin),
        "--minimum-separation", str(arguments.spawn_minimum_separation),
    ]
    if arguments.reject_non_static:
        # A formal batch can afford to insist. Every acceptance world is fully
        # static, so this costs nothing today and refuses the day someone adds
        # a prop the sampler could only avoid approximately.
        command.append("--reject-non-static")
    completed = subprocess.run(
        command, capture_output=True, text=True, check=True
    )
    result = json.loads(completed.stdout.strip().splitlines()[-1])
    # The sampler is told an absolute path because that is what it has to open;
    # the record does not have to keep it.
    result["world"] = portable_world_path(result.get("world"))
    version = result.get("schema_version")
    if not isinstance(version, int) or version < MINIMUM_SPAWN_SCHEMA_VERSION:
        raise RuntimeError(
            f"spawn sampler reported schema_version {version!r}, need at least "
            f"{MINIMUM_SPAWN_SCHEMA_VERSION}; the installed sampler predates "
            "recorded sampling parameters"
        )
    if not result.get("parameters") or not result.get("sampling_bounds"):
        raise RuntimeError(
            "spawn sampler omitted parameters or sampling_bounds, so this batch "
            "could not be replayed"
        )
    poses = result.get("poses", [])
    if len(poses) != arguments.runs:
        raise RuntimeError(
            f"spawn sampler returned {len(poses)} poses for {arguments.runs} runs"
        )
    return poses, result


def minimum_spawn_distance(poses):
    if len(poses) < 2:
        return None
    return min(
        ((left["x"] - right["x"]) ** 2 +
         (left["y"] - right["y"]) ** 2) ** 0.5
        for index, left in enumerate(poses)
        for right in poses[index + 1:]
    )


def leftover_processes():
    if shutil.which("pgrep") is None:
        return []
    found = []
    for pattern in LEFTOVER_PROCESS_PATTERNS:
        result = subprocess.run(
            ["pgrep", "-f", pattern], capture_output=True, text=True, check=False
        )
        if result.returncode == 0 and result.stdout.strip():
            found.append(pattern)
    return found


def end_process_group(launch, group, settle_seconds):
    """Stop the launch and everything it started, and nothing else.

    The launch runs in its own session, so its process group covers the
    simulator and every node it spawned. Signalling that group leaves any other
    Gazebo or Nav2 on the machine untouched, which matching on command lines
    would not.

    The group is the id saved when the launch started, not one looked up from
    the parent now. The case worth cleaning up is exactly the one where the
    parent went first and left the simulator orphaned in the group behind it;
    asking a departed pid for its group finds nothing and returns having killed
    nobody. The saved id stays safe to signal because the kernel will not hand
    that number to an unrelated process while it is still in use as a group id,
    and once the group empties killpg reports that instead.

    Progress is judged on the group for the same reason. Waiting on the parent
    says nothing once it has been reaped, and the wait then returns at once
    while the simulator is still up. Reaping it inside the loop matters too: a
    zombie is still a member of its group and still answers signal 0, so an
    unreaped parent would make an otherwise empty group look alive.
    """
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(group, sig)
        except ProcessLookupError:
            return
        deadline = time.monotonic() + settle_seconds
        while True:
            launch.poll()
            try:
                os.killpg(group, 0)
            except ProcessLookupError:
                return
            if time.monotonic() >= deadline:
                break
            time.sleep(0.2)


def parse_run(text, exit_code, timed_out=False, simulator_died=False):
    """Prefer the reported verdict over the exit code.

    They agree in normal operation. When the launch wrapper masks the child's
    status they do not, and silently trusting the exit code would turn a
    reported FAIL into a campaign pass.

    A run killed on its timeout never reaches its own scoring, so it has no
    verdict to report. Charging that to the algorithm would repeat the mistake
    of blaming the code for the machine: a launch that hangs says nothing about
    exploration, so it belongs with the environment. A missing verdict for any
    other reason still fails, because a run that did not report cannot be
    assumed to have passed.
    """
    match = VERDICT_PATTERN.search(text)
    reported = match.group(1) if match else None
    verdict = {v: k for k, v in VERDICT_NAMES.items()}.get(reported)
    if verdict is None:
        verdict = INFRA_UNSTABLE if timed_out or simulator_died else FAIL
    record = {
        "verdict": verdict,
        "launch_timed_out": timed_out,
        "simulator_died_before_verdict": simulator_died,
        "verdict_reported": reported,
        "exit_code": exit_code,
        "verdict_missing": reported is None,
        "gazebo_teardown_crash": bool(GAZEBO_CRASH_PATTERN.search(text)),
        "failed_checks": FAILED_CHECK_PATTERN.findall(text),
    }
    for name, pattern in MEASUREMENT_PATTERNS.items():
        found = re.search(pattern, text, re.S)
        record[name] = float(found.group(1)) if found else None
    healthy = HOST_HEALTHY_PATTERN.search(text)
    record["host_healthy"] = None if healthy is None else healthy.group(1) == "yes"
    fault = EXPLORATION_FAULT_PATTERN.search(text)
    record["exploration_fault_class"] = None if fault is None else fault.group(1)
    record["exploration_fault_code"] = None if fault is None else fault.group(2)
    overshoot = WALL_OVERSHOOT_PATTERN.search(text)
    # Kept per side. The one map distortion seen so far pushed north and south
    # out together, which a single width or height cannot distinguish from one
    # wall smearing.
    record["wall_overshoot_m"] = None if overshoot is None else {
        side: float(value) for side, value
        in zip(("west", "south", "east", "north"), overshoot.groups())
    }
    return record


def judge(runs, arguments):
    """Apply the pre-registered rule and say why, in one place.

    Runs attributed to the host leave the denominator rather than counting
    against the algorithm. Judging passes out of the full batch looks stricter
    but is not: with no core failure the pass count is just the batch size
    minus the host-attributed runs, so two of those would reject the algorithm
    for something already decided to be the machine's fault. That also made
    the environment budget unreachable, since the pass count condemned the
    batch one run before the budget was spent.
    """
    total = len(runs)
    passes = sum(1 for run in runs if run["verdict"] == PASS)
    fails = [run for run in runs if run["verdict"] == FAIL]
    infra = sum(1 for run in runs if run["verdict"] == INFRA_UNSTABLE)
    evaluable = total - infra
    if evaluable < arguments.minimum_evaluable_runs:
        return "BATCH_INVALID", (
            f"only {evaluable}/{total} runs were evaluable ({infra} attributed "
            "to the host); this batch cannot say anything about the algorithm"
        )
    if fails:
        return "REJECTED", (
            f"{len(fails)}/{evaluable} evaluable runs failed a core criterion"
        )
    return "ACCEPTED", (
        f"{passes}/{evaluable} evaluable runs passed, {infra} attributed to "
        "the host"
    )


def parse_arguments(arguments):
    parser = argparse.ArgumentParser()
    parser.add_argument("--runs", type=int, default=5)
    # How many runs must survive host attribution for the batch to mean
    # anything. Every evaluable run then has to pass: a core failure is a core
    # failure regardless of how many siblings it had.
    parser.add_argument("--minimum-evaluable-runs", type=int, default=4)
    parser.add_argument("--launch-file", default="frontier_exploration_regression.launch.py")
    parser.add_argument("--world")
    # No default. The two must travel together: a profile alone was silently
    # discarded while the default world ran, and a world alone would have been
    # scored against another world's gates, which is the more dangerous half of
    # the same mistake.
    parser.add_argument("--world-profile")
    parser.add_argument("--random-spawn", action="store_true")
    parser.add_argument("--campaign-seed", type=int, default=20260812)
    parser.add_argument("--spawn-safety-margin", type=float, default=0.15)
    parser.add_argument("--spawn-robot-height", type=float, default=0.35)
    parser.add_argument("--spawn-vertical-margin", type=float, default=0.10)
    # Exposed because the right spread depends on the world: 2 m between five
    # poses is generous in a 26 m corridor and barely a spread in a 12 x 10 m
    # room.
    parser.add_argument("--spawn-minimum-separation", type=float, default=2.0)
    parser.add_argument("--reject-non-static", action="store_true")
    # Relative to the working directory on purpose, so a batch survives the
    # session that produced it. Thirty runs were once written to a scratch
    # directory and lost, leaving hand-copied tables as the only record.
    parser.add_argument("--log-directory", default="campaign_logs")
    # A batch is the evidence for a claim, so it must not be able to erase the
    # batch it is being compared against. Reusing a directory is opt-in.
    parser.add_argument("--overwrite-log-directory", action="store_true")
    parser.add_argument("--settle-seconds", type=float, default=15.0)
    # Bounds a hung launch. A regression that stops reporting eventually hits
    # its own wall timeout, but a launch that hangs outside it would otherwise
    # stall an unattended batch forever.
    parser.add_argument("--run-timeout-seconds", type=float, default=1500.0)
    parser.add_argument(
        "--launch-argument", "-a", action="append", default=[],
        metavar="NAME:=VALUE",
        help="Extra launch argument for every run; repeatable.")
    parser.add_argument(
        "--allow-leftover-processes", action="store_true",
        help="Start even if a previous simulation is still running.")
    parsed = parser.parse_args(arguments)
    if parsed.runs <= 0:
        parser.error("--runs must be positive")
    if parsed.minimum_evaluable_runs > parsed.runs:
        parser.error("--minimum-evaluable-runs cannot exceed --runs")
    if parsed.minimum_evaluable_runs <= 0:
        parser.error("--minimum-evaluable-runs must be positive")
    if parsed.campaign_seed <= 0:
        parser.error("--campaign-seed must be positive")
    if parsed.spawn_safety_margin < 0.0:
        parser.error("--spawn-safety-margin must be non-negative")
    if parsed.spawn_robot_height <= 0.0:
        parser.error("--spawn-robot-height must be positive")
    if parsed.spawn_vertical_margin < 0.0:
        parser.error("--spawn-vertical-margin must be non-negative")
    if parsed.random_spawn and not parsed.world:
        parser.error("--world is required with --random-spawn")
    if bool(parsed.world) != bool(parsed.world_profile):
        parser.error(
            "--world and --world-profile must be given together: the profile "
            "carries this world's acceptance gates, and either one alone is "
            "silently scored against the other world's")
    if parsed.spawn_minimum_separation < 0.0:
        parser.error("--spawn-minimum-separation must be non-negative")
    return parsed


def main():
    arguments = parse_arguments(sys.argv[1:])
    leftover = leftover_processes()
    if leftover and not arguments.allow_leftover_processes:
        print(
            f"REFUSING TO START: leftover processes match {leftover}. "
            "Stop them first, or pass --allow-leftover-processes.",
            flush=True,
        )
        return 3
    log_directory = Path(arguments.log_directory)
    existing = sorted(log_directory.glob("run_*.log"))
    if existing and not arguments.overwrite_log_directory:
        print(
            f"REFUSING TO START: {log_directory} already holds "
            f"{len(existing)} run logs. Choose another --log-directory, or "
            "pass --overwrite-log-directory to discard them.",
            flush=True,
        )
        return 3
    log_directory.mkdir(parents=True, exist_ok=True)

    # Read once, before the first run, so a tree edited mid-batch is recorded as
    # the tree the batch started from rather than the one it happened to end on.
    revision = source_revision()

    try:
        spawn_poses, spawn_sampling = sample_spawns(arguments)
    except (ValueError, RuntimeError, subprocess.SubprocessError, json.JSONDecodeError) as error:
        print(f"REFUSING TO START: could not generate safe spawns: {error}", flush=True)
        return 3

    world_sha256 = None
    if arguments.world:
        world_sha256 = hashlib.sha256(Path(arguments.world).read_bytes()).hexdigest()

    runs = []
    for index in range(1, arguments.runs + 1):
        log_path = log_directory / f"run_{index:02d}.log"
        print(f"=== campaign run {index}/{arguments.runs} -> {log_path}", flush=True)
        started = time.monotonic()
        timed_out = False
        simulator_died = False
        with open(log_path, "w", encoding="utf-8") as handle:
            # Own session, so this run's simulator and nodes share one process
            # group that can be ended without naming them. Matching on command
            # lines instead would reach any Gazebo or Nav2 the machine happens
            # to be running, including a user's own work in another terminal.
            launch = subprocess.Popen(
                launch_command(arguments, spawn_poses[index - 1]),
                stdout=handle, stderr=subprocess.STDOUT, start_new_session=True,
            )
            # start_new_session makes the launch its own group leader, so its
            # pid is the group id. Saved now because it is still needed after
            # the launch itself has gone.
            group = launch.pid
            deadline = time.monotonic() + arguments.run_timeout_seconds
            completed_returncode = None
            while True:
                completed_returncode = launch.poll()
                if completed_returncode is not None:
                    break
                if time.monotonic() >= deadline:
                    timed_out = True
                    end_process_group(launch, group, arguments.settle_seconds)
                    break
                current_text = log_path.read_text(
                    encoding="utf-8", errors="replace"
                )
                # A dead Gazebo server leaves launch, SLAM and Nav2 alive, so
                # waiting only for the launch timeout wastes many minutes and
                # reports a misleading TF failure. Stop immediately unless a
                # verdict already proves this was only the known teardown
                # crash after scoring completed.
                if (GAZEBO_CRASH_PATTERN.search(current_text) and
                        VERDICT_PATTERN.search(current_text) is None):
                    simulator_died = True
                    end_process_group(launch, group, arguments.settle_seconds)
                    break
                time.sleep(1.0)
        text = log_path.read_text(encoding="utf-8", errors="replace")
        record = parse_run(
            text, completed_returncode, timed_out, simulator_died
        )
        record["index"] = index
        record["wall_seconds"] = round(time.monotonic() - started, 1)
        record["log"] = str(log_path)
        record["spawn"] = spawn_poses[index - 1]
        runs.append(record)
        print(
            f"    verdict={VERDICT_NAMES[record['verdict']]} "
            f"exit={record['exit_code']} "
            f"wall={record['wall_seconds']} s "
            f"gazebo_teardown_crash={record['gazebo_teardown_crash']} "
            f"failed={record['failed_checks'] or '-'}",
            flush=True,
        )
        time.sleep(arguments.settle_seconds)
        # Checked between runs, not only before the batch. A run that failed to
        # tear down would otherwise share the machine with the next one, which
        # is exactly the contention these measurements are meant to exclude.
        # Only this run's own process group is ended: whatever else the machine
        # is running is the operator's business, not this script's.
        remaining = leftover_processes()
        if remaining:
            print(f"    {remaining} still running after run {index}; stopping it",
                  flush=True)
            end_process_group(launch, group, arguments.settle_seconds)
            remaining = leftover_processes()
        if remaining:
            record["left_processes_running"] = remaining
            print(
                f"ABORTING: {remaining} survived cleanup after run {index}. "
                "Every later run would share this machine with it, so the "
                "batch stops here rather than recording contaminated samples.",
                flush=True,
            )
            break

    outcome, reason = judge(runs, arguments)
    summary = {
        "outcome": outcome,
        "reason": reason,
        "runs": runs,
        "passes": sum(1 for run in runs if run["verdict"] == PASS),
        "core_failures": sum(1 for run in runs if run["verdict"] == FAIL),
        "infra_unstable": sum(1 for run in runs if run["verdict"] == INFRA_UNSTABLE),
        "gazebo_teardown_crashes": sum(
            1 for run in runs if run["gazebo_teardown_crash"]),
        "criteria": {
            "runs": arguments.runs,
            "minimum_evaluable_runs": arguments.minimum_evaluable_runs,
        },
        "world": {
            "path": portable_world_path(arguments.world),
            "sha256": world_sha256,
            "profile": arguments.world_profile,
        },
        "source_revision": revision,
        "spawn_sampling": spawn_sampling,
        "minimum_spawn_distance_m": (
            minimum_spawn_distance(spawn_poses)
            if arguments.random_spawn else None
        ),
    }
    (log_directory / "campaign_summary.json").write_text(
        json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(f"CAMPAIGN {outcome}: {reason}", flush=True)
    print(
        f"  passes={summary['passes']} core_failures={summary['core_failures']} "
        f"infra_unstable={summary['infra_unstable']} "
        f"gazebo_teardown_crashes={summary['gazebo_teardown_crashes']}",
        flush=True,
    )
    return 0 if outcome == "ACCEPTED" else 1


if __name__ == "__main__":
    raise SystemExit(main())
