#!/usr/bin/env python3

"""Run a multi-speed in-place rotation regression for the custom 2D SLAM."""

import argparse
import math
import sys
import time

from diagnostic_msgs.msg import DiagnosticArray
from geometry_msgs.msg import Twist
from nav_msgs.msg import OccupancyGrid, Odometry, Path
from rcl_interfaces.msg import Log
import rclpy
from rclpy.node import Node
from rclpy.parameter import Parameter
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy


CRITICAL_LOG_FRAGMENTS = (
    'Aborted occupancy grid rebuild',
    'Aborted queued occupancy grid rebuild',
    'Discarded incompatible loop closure result',
    'Failed to create occupancy grid snapshot',
    'Failed to start loop closure worker',
    'Fatal SLAM node error',
    'Loop closure committed but occupancy grid rebuild failed to start',
    'Loop closure committed but pose graph path refresh failed',
    'Loop closure worker failed',
    'Rejected LaserScan after processing error',
)
MATCHER_DIAGNOSTIC_NAME = 'scan_matcher_odometry/front_end_matcher'


def yaw_from_quaternion(orientation):
    sin_yaw = 2.0 * (
        orientation.w * orientation.z
        + orientation.x * orientation.y
    )
    cos_yaw = 1.0 - 2.0 * (
        orientation.y * orientation.y
        + orientation.z * orientation.z
    )
    return math.atan2(sin_yaw, cos_yaw)


def normalize_angle(angle):
    return math.atan2(math.sin(angle), math.cos(angle))


def pose_from_odometry(message):
    position = message.pose.pose.position
    return (
        position.x,
        position.y,
        yaw_from_quaternion(message.pose.pose.orientation),
    )


def relative_pose(start, finish):
    dx = finish[0] - start[0]
    dy = finish[1] - start[1]
    cosine = math.cos(start[2])
    sine = math.sin(start[2])
    return (
        cosine * dx + sine * dy,
        -sine * dx + cosine * dy,
        normalize_angle(finish[2] - start[2]),
    )


def stamp_to_seconds(stamp):
    return float(stamp.sec) + float(stamp.nanosec) * 1.0e-9


def map_statistics(message):
    occupied_cells = sum(value >= 65 for value in message.data)
    return {
        'width': message.info.width,
        'height': message.info.height,
        'area': message.info.width * message.info.height,
        'occupied_cells': occupied_cells,
    }


class RotationRegression(Node):
    def __init__(self):
        super().__init__(
            'rotation_regression',
            parameter_overrides=[
                Parameter('use_sim_time', value=True),
            ],
        )
        self.poses = {}
        self.latest_map = None
        self.map_messages = 0
        self.maximum_pose_graph_nodes = 0
        self.matcher_stamp = None
        self.maximum_matcher_gap = 0.0
        self.loop_closures = 0
        self.match_rejection_warnings = 0
        self.critical_logs = []
        self.match_attempts = 0
        self.degenerate_events = 0
        self.malformed_diagnostics = 0
        self.publisher = self.create_publisher(Twist, '/cmd_vel', 10)
        self.create_subscription(
            Odometry,
            '/ground_truth/odom',
            lambda message: self.store_pose('truth', message),
            20,
        )
        self.create_subscription(
            Odometry,
            '/odom',
            lambda message: self.store_pose('wheel', message),
            20,
        )
        self.create_subscription(
            Odometry,
            '/custom_slam/laser_odom',
            self.matcher_callback,
            20,
        )
        self.create_subscription(
            DiagnosticArray,
            '/custom_slam/matcher_diagnostics',
            self.matcher_diagnostics_callback,
            100,
        )
        map_qos = QoSProfile(
            depth=1,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
        )
        self.create_subscription(
            OccupancyGrid,
            '/custom_slam/map',
            self.map_callback,
            map_qos,
        )
        self.create_subscription(
            Path,
            '/custom_slam/pose_graph_path',
            self.pose_graph_path_callback,
            10,
        )
        self.create_subscription(Log, '/rosout', self.log_callback, 100)

    def store_pose(self, name, message):
        self.poses[name] = pose_from_odometry(message)

    def matcher_callback(self, message):
        self.store_pose('matcher', message)
        stamp = stamp_to_seconds(message.header.stamp)
        if self.matcher_stamp is not None and stamp > self.matcher_stamp:
            self.maximum_matcher_gap = max(
                self.maximum_matcher_gap,
                stamp - self.matcher_stamp,
            )
        self.matcher_stamp = stamp

    def matcher_diagnostics_callback(self, message):
        for status in message.status:
            if (
                status.name != MATCHER_DIAGNOSTIC_NAME
                or not status.message.startswith('match_')
            ):
                continue
            values = {entry.key: entry.value for entry in status.values}
            try:
                rank = int(values['translation_observable_rank'])
            except (KeyError, ValueError):
                self.malformed_diagnostics += 1
                continue
            self.match_attempts += 1
            if rank < 2:
                self.degenerate_events += 1

    def map_callback(self, message):
        self.latest_map = map_statistics(message)
        self.map_messages += 1

    def pose_graph_path_callback(self, message):
        self.maximum_pose_graph_nodes = max(
            self.maximum_pose_graph_nodes,
            len(message.poses),
        )

    def log_callback(self, message):
        if message.name != 'scan_matcher_odometry':
            return
        if 'Accepted loop closure' in message.msg:
            self.loop_closures += 1
        if 'Correlative match rejected' in message.msg:
            self.match_rejection_warnings += 1
        if any(
            fragment in message.msg
            for fragment in CRITICAL_LOG_FRAGMENTS
        ):
            self.critical_logs.append(message.msg)

    def simulation_time(self):
        return self.get_clock().now().nanoseconds * 1.0e-9

    def wait_for_inputs(self, timeout):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            rclpy.spin_once(self, timeout_sec=0.1)
            if len(self.poses) == 3 and self.latest_map is not None:
                return
        raise RuntimeError(
            'Timed out waiting for odometry and occupancy-grid topics'
        )

    def publish_command(self, angular):
        command = Twist()
        command.angular.z = angular
        self.publisher.publish(command)

    def spin_for_simulation_duration(self, duration, angular):
        started = self.simulation_time()
        wall_started = time.monotonic()
        wall_timeout = duration * 5.0 + 30.0
        while rclpy.ok():
            elapsed = self.simulation_time() - started
            if elapsed >= duration:
                return
            if time.monotonic() - wall_started > wall_timeout:
                raise RuntimeError(
                    'Rotation timed out while simulation time stalled'
                )
            self.publish_command(angular)
            rclpy.spin_once(self, timeout_sec=0.025)

    def settle(self, seconds):
        self.spin_for_simulation_duration(seconds, 0.0)

    def evaluate_stage(
        self,
        speed,
        starts,
        map_before,
        nodes_before,
        loops_before,
        rejections_before,
        matches_before,
        degeneracy_before,
        malformed_before,
        arguments,
    ):
        motions = {
            name: relative_pose(starts[name], self.poses[name])
            for name in starts
        }
        truth = motions['truth']
        matcher = motions['matcher']
        wheel = motions['wheel']
        matcher_translation_error = math.hypot(
            matcher[0] - truth[0],
            matcher[1] - truth[1],
        )
        matcher_yaw_error = abs(
            normalize_angle(matcher[2] - truth[2])
        )
        wheel_translation_error = math.hypot(
            wheel[0] - truth[0],
            wheel[1] - truth[1],
        )
        wheel_yaw_error = abs(normalize_angle(wheel[2] - truth[2]))
        map_after = dict(self.latest_map)
        map_area_growth = (
            map_after['area'] / max(map_before['area'], 1)
        )
        occupied_growth = (
            map_after['occupied_cells']
            / max(map_before['occupied_cells'], 1)
        )
        stage_loops = self.loop_closures - loops_before
        stage_rejections = (
            self.match_rejection_warnings - rejections_before
        )
        stage_nodes = self.maximum_pose_graph_nodes - nodes_before
        stage_matches = self.match_attempts - matches_before
        stage_degenerate_events = (
            self.degenerate_events - degeneracy_before
        )
        stage_malformed_diagnostics = (
            self.malformed_diagnostics - malformed_before
        )

        checks = {
            'translation_drift_bounded': (
                matcher_translation_error
                <= arguments.maximum_translation_error
            ),
            'yaw_error_bounded': (
                matcher_yaw_error
                <= math.radians(arguments.maximum_yaw_error_degrees)
            ),
            'front_end_gap_bounded': (
                self.maximum_matcher_gap
                <= arguments.maximum_matcher_gap
            ),
            'map_area_bounded': (
                map_area_growth <= arguments.maximum_map_area_growth
            ),
            'occupied_cells_bounded': (
                occupied_growth
                <= arguments.maximum_occupied_cell_growth
            ),
            'no_match_rejection_warning': stage_rejections == 0,
            'no_loop_closure': stage_loops == 0,
            'keyframes_created': (
                stage_nodes >= arguments.minimum_keyframes_per_stage
            ),
            'no_critical_slam_logs': not self.critical_logs,
            'normal_matches_observed': stage_matches > 0,
            'no_false_degeneracy': stage_degenerate_events == 0,
            'matcher_diagnostics_well_formed': (
                stage_malformed_diagnostics == 0
            ),
        }

        print(f'\nrotation stage {speed:.2f} rad/s')
        print(
            f'truth motion  : x={truth[0]:.4f} y={truth[1]:.4f} '
            f'yaw={math.degrees(truth[2]):.3f} deg'
        )
        print(
            f'wheel error  : translation={wheel_translation_error:.4f} m '
            f'yaw={math.degrees(wheel_yaw_error):.3f} deg'
        )
        print(
            'matcher error: '
            f'translation={matcher_translation_error:.4f} m '
            f'yaw={math.degrees(matcher_yaw_error):.3f} deg'
        )
        print(
            f'map growth   : area={map_area_growth:.3f} '
            f'occupied={occupied_growth:.3f}'
        )
        print(
            f'front-end gap: {self.maximum_matcher_gap:.3f} s, '
            f'keyframes={stage_nodes}, '
            f'rejections={stage_rejections}, loops={stage_loops}'
        )
        print(
            f'observability : matches={stage_matches}, '
            f'degenerate={stage_degenerate_events}, '
            f'malformed={stage_malformed_diagnostics}'
        )
        for name, passed in checks.items():
            print(f"  [{'PASS' if passed else 'FAIL'}] {name}")
        return {
            'speed': speed,
            'passed': all(checks.values()),
            'translation_error': matcher_translation_error,
            'yaw_error': matcher_yaw_error,
            'maximum_matcher_gap': self.maximum_matcher_gap,
            'map_area_growth': map_area_growth,
            'occupied_growth': occupied_growth,
            'keyframes': stage_nodes,
            'rejections': stage_rejections,
            'loops': stage_loops,
            'matches': stage_matches,
            'degenerate_events': stage_degenerate_events,
        }

    def run_stage(self, speed, arguments):
        starts = dict(self.poses)
        map_before = dict(self.latest_map)
        nodes_before = self.maximum_pose_graph_nodes
        loops_before = self.loop_closures
        rejections_before = self.match_rejection_warnings
        matches_before = self.match_attempts
        degeneracy_before = self.degenerate_events
        malformed_before = self.malformed_diagnostics
        self.maximum_matcher_gap = 0.0
        self.matcher_stamp = None
        duration = (
            arguments.rotations * 2.0 * math.pi / abs(speed)
        )
        print(
            f'\nstarting {arguments.rotations:.1f} rotations at '
            f'{speed:.2f} rad/s ({duration:.1f} s)',
            flush=True,
        )
        self.spin_for_simulation_duration(duration, speed)
        self.publish_command(0.0)
        self.settle(arguments.settle_time)
        return self.evaluate_stage(
            speed,
            starts,
            map_before,
            nodes_before,
            loops_before,
            rejections_before,
            matches_before,
            degeneracy_before,
            malformed_before,
            arguments,
        )

    def run(self, arguments):
        self.wait_for_inputs(arguments.startup_timeout)
        warmup_speed = abs(arguments.angular_speeds[0])
        warmup_duration = (
            arguments.warmup_rotations * 2.0 * math.pi / warmup_speed
        )
        if warmup_duration > 0.0:
            print(
                f'\nwarming up the map for '
                f'{arguments.warmup_rotations:.1f} rotations at '
                f'{warmup_speed:.2f} rad/s ({warmup_duration:.1f} s)',
                flush=True,
            )
            self.spin_for_simulation_duration(
                warmup_duration,
                warmup_speed,
            )
            self.publish_command(0.0)
            self.settle(arguments.settle_time)

        warmup_passed = (
            self.loop_closures == 0
            and self.match_rejection_warnings == 0
            and self.match_attempts > 0
            and self.degenerate_events == 0
            and self.malformed_diagnostics == 0
            and not self.critical_logs
        )
        print(
            'warmup checks: '
            f"{'PASS' if warmup_passed else 'FAIL'} "
            f'(rejections={self.match_rejection_warnings}, '
            f'loops={self.loop_closures}, '
            f'matches={self.match_attempts}, '
            f'degenerate={self.degenerate_events}, '
            f'malformed={self.malformed_diagnostics}, '
            f'critical_logs={len(self.critical_logs)})'
        )
        results = [
            self.run_stage(speed, arguments)
            for speed in arguments.angular_speeds
        ]
        passed = (
            warmup_passed
            and all(result['passed'] for result in results)
        )
        print(
            f'\nrotation regression: '
            f"{'PASS' if passed else 'FAIL'} "
            f"({sum(result['passed'] for result in results)}/"
            f'{len(results)} stages)'
        )
        return passed


def parse_arguments():
    parser = argparse.ArgumentParser(
        description='Run a custom-SLAM in-place rotation regression.'
    )
    parser.add_argument(
        '--angular-speeds',
        type=float,
        nargs='+',
        default=(0.3, 0.6, 1.0),
    )
    parser.add_argument('--warmup-rotations', type=float, default=1.0)
    parser.add_argument('--rotations', type=float, default=2.0)
    parser.add_argument('--settle-time', type=float, default=3.0)
    parser.add_argument('--startup-timeout', type=float, default=15.0)
    parser.add_argument('--maximum-matcher-gap', type=float, default=0.25)
    parser.add_argument(
        '--maximum-translation-error',
        type=float,
        default=0.05,
    )
    parser.add_argument(
        '--maximum-yaw-error-degrees',
        type=float,
        default=1.0,
    )
    parser.add_argument(
        '--maximum-map-area-growth',
        type=float,
        default=1.10,
    )
    parser.add_argument(
        '--maximum-occupied-cell-growth',
        type=float,
        default=1.50,
    )
    parser.add_argument(
        '--minimum-keyframes-per-stage',
        type=int,
        default=80,
    )
    arguments, ros_arguments = parser.parse_known_args()
    if ros_arguments:
        sys.argv = [sys.argv[0], *ros_arguments]
    if (
        not arguments.angular_speeds
        or any(speed == 0.0 for speed in arguments.angular_speeds)
        or arguments.warmup_rotations < 0.0
        or arguments.rotations <= 0.0
        or arguments.settle_time < 0.0
        or arguments.minimum_keyframes_per_stage < 1
    ):
        parser.error('Rotation speeds, count and thresholds must be positive')
    return arguments


def main():
    arguments = parse_arguments()
    rclpy.init()
    node = RotationRegression()
    exit_code = 1
    try:
        exit_code = 0 if node.run(arguments) else 1
    except (KeyboardInterrupt, RuntimeError) as error:
        print(f'rotation regression failed: {error}', file=sys.stderr)
    finally:
        node.publish_command(0.0)
        node.destroy_node()
        rclpy.shutdown()
    raise SystemExit(exit_code)


if __name__ == '__main__':
    main()
