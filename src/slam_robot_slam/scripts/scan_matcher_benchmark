#!/usr/bin/env python3

import math
import time

from geometry_msgs.msg import Twist
from nav_msgs.msg import Odometry
import rclpy
from rclpy.node import Node


def yaw_from_quaternion(orientation):
    sin_yaw = 2.0 * (
        orientation.w * orientation.z
        + orientation.x * orientation.y
    )
    cos_yaw = 1.0 - 2.0 * (
        orientation.y * orientation.y
        + orientation.z * orientation.z
    )
    return math.atan2(sin_yaw, cos_yaw)


def normalize_angle(angle):
    return math.atan2(math.sin(angle), math.cos(angle))


def pose_from_odometry(message):
    position = message.pose.pose.position
    return (position.x, position.y, yaw_from_quaternion(message.pose.pose.orientation))


def relative_pose(start, finish):
    dx = finish[0] - start[0]
    dy = finish[1] - start[1]
    cosine = math.cos(start[2])
    sine = math.sin(start[2])
    return (
        cosine * dx + sine * dy,
        -sine * dx + cosine * dy,
        normalize_angle(finish[2] - start[2]),
    )


class ScanMatcherBenchmark(Node):
    def __init__(self):
        super().__init__('scan_matcher_benchmark')
        self.poses = {}
        self.publisher = self.create_publisher(Twist, '/cmd_vel', 10)
        self.create_subscription(
            Odometry,
            '/ground_truth/odom',
            lambda message: self.store_pose('truth', message),
            10,
        )
        self.create_subscription(
            Odometry,
            '/odom',
            lambda message: self.store_pose('wheel', message),
            10,
        )
        self.create_subscription(
            Odometry,
            '/custom_slam/laser_odom',
            lambda message: self.store_pose('matcher', message),
            10,
        )

    def store_pose(self, name, message):
        self.poses[name] = pose_from_odometry(message)

    def wait_for_inputs(self, timeout=10.0):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            rclpy.spin_once(self, timeout_sec=0.1)
            if len(self.poses) == 3:
                return
        raise RuntimeError(
            'Timed out waiting for truth, wheel and matcher odometry'
        )

    def command_for_elapsed_time(self, elapsed):
        if elapsed < 4.0:
            return (0.25, 0.0)
        if elapsed < 9.0:
            return (0.20, 0.30)
        if elapsed < 12.0:
            return (0.0, -0.45)
        if elapsed < 16.0:
            return (0.22, 0.0)
        return (0.0, 0.0)

    def publish_command(self, linear, angular):
        command = Twist()
        command.linear.x = linear
        command.angular.z = angular
        self.publisher.publish(command)

    def run_route(self):
        self.wait_for_inputs()
        starts = dict(self.poses)
        started = time.monotonic()
        while True:
            elapsed = time.monotonic() - started
            linear, angular = self.command_for_elapsed_time(elapsed)
            self.publish_command(linear, angular)
            rclpy.spin_once(self, timeout_sec=0.05)
            if elapsed >= 17.0:
                break
        self.publish_command(0.0, 0.0)

        motions = {
            name: relative_pose(starts[name], self.poses[name])
            for name in starts
        }
        truth = motions['truth']
        print('trajectory benchmark')
        for name in ('truth', 'wheel', 'matcher'):
            pose = motions[name]
            print(
                f'{name:7s}: x={pose[0]:.6f} y={pose[1]:.6f} '
                f'yaw={math.degrees(pose[2]):.6f} deg'
            )
        for name in ('wheel', 'matcher'):
            pose = motions[name]
            translation_error = math.hypot(
                pose[0] - truth[0],
                pose[1] - truth[1],
            )
            yaw_error = normalize_angle(pose[2] - truth[2])
            print(
                f'{name:7s} error: translation={translation_error:.6f} m '
                f'yaw={math.degrees(yaw_error):.6f} deg'
            )


def main():
    rclpy.init()
    node = ScanMatcherBenchmark()
    try:
        node.run_route()
    finally:
        node.publish_command(0.0, 0.0)
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
