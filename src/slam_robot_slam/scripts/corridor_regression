#!/usr/bin/env python3

"""Run one-way or return-trip degenerate-corridor SLAM regressions."""

import argparse
import math
import re
import sys
import time

from diagnostic_msgs.msg import DiagnosticArray
from geometry_msgs.msg import Twist
from nav_msgs.msg import OccupancyGrid, Odometry, Path
from rcl_interfaces.msg import Log
import rclpy
from rclpy.node import Node
from rclpy.parameter import Parameter
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy


CRITICAL_LOG_FRAGMENTS = (
    'Aborted occupancy grid rebuild',
    'Aborted queued occupancy grid rebuild',
    'Discarded incompatible loop closure result',
    'Failed to create occupancy grid snapshot',
    'Failed to start loop closure worker',
    'Fatal SLAM node error',
    'Loop closure committed but occupancy grid rebuild failed to start',
    'Loop closure committed but pose graph path refresh failed',
    'Loop closure worker failed',
    'Rejected LaserScan after processing error',
)

MATCHER_DIAGNOSTIC_NAME = 'scan_matcher_odometry/front_end_matcher'
LOOP_CLOSURE_PATTERN = re.compile(
    r'Accepted loop closure (\d+) -> (\d+): .*'
    r'rank=(\d+) translation_info=\[([\d.eE+-]+), ([\d.eE+-]+)\]'
)
DIAGNOSTIC_COUNTER_NAMES = (
    'event_sequence',
    'bootstrap_scans',
    'insufficient_point_scans',
    'motion_below_threshold_scans',
    'match_attempts',
    'accepted_matches',
    'rejected_matches',
    'rank_zero_matches',
    'rank_one_matches',
    'rank_two_matches',
    'suppressed_matches',
)


def yaw_from_quaternion(orientation):
    sin_yaw = 2.0 * (
        orientation.w * orientation.z
        + orientation.x * orientation.y
    )
    cos_yaw = 1.0 - 2.0 * (
        orientation.y * orientation.y
        + orientation.z * orientation.z
    )
    return math.atan2(sin_yaw, cos_yaw)


def normalize_angle(angle):
    return math.atan2(math.sin(angle), math.cos(angle))


def pose_from_odometry(message):
    position = message.pose.pose.position
    return (
        position.x,
        position.y,
        yaw_from_quaternion(message.pose.pose.orientation),
    )


def relative_pose(start, finish):
    dx = finish[0] - start[0]
    dy = finish[1] - start[1]
    cosine = math.cos(start[2])
    sine = math.sin(start[2])
    return (
        cosine * dx + sine * dy,
        -sine * dx + cosine * dy,
        normalize_angle(finish[2] - start[2]),
    )


def stamp_to_seconds(stamp):
    return float(stamp.sec) + float(stamp.nanosec) * 1.0e-9


def histogram(values, boundaries):
    counts = [0] * (len(boundaries) - 1)
    for value in values:
        for index, (lower, upper) in enumerate(
            zip(boundaries[:-1], boundaries[1:])
        ):
            if lower <= value < upper or (
                index == len(counts) - 1 and value == upper
            ):
                counts[index] += 1
                break
    return counts


class CorridorRegression(Node):
    def __init__(self):
        super().__init__(
            'corridor_regression',
            parameter_overrides=[
                Parameter('use_sim_time', value=True),
            ],
        )
        self.poses = {}
        self.starts = None
        self.measuring = False
        self.samples = 0
        self.maximum_longitudinal_error = 0.0
        self.maximum_lateral_error = 0.0
        self.maximum_yaw_error = 0.0
        self.matcher_stamp = None
        self.maximum_matcher_gap = 0.0
        self.degenerate_covariance_samples = 0
        self.regular_covariance_samples = 0
        self.maximum_covariance_ratio = 1.0
        self.latest_diagnostic_counters = None
        self.diagnostic_baseline = None
        self.match_information_ratios = []
        self.weak_direction_angles = []
        self.degenerate_segment_matches = 0
        self.degenerate_segment_detections = 0
        self.malformed_diagnostics = 0
        self.latest_map = None
        self.map_messages = 0
        self.maximum_pose_graph_nodes = 0
        self.loop_closures = []
        self.map_rebuilds = []
        self.match_rejection_warnings = 0
        self.critical_logs = []
        self.outbound_distance = 0.0
        self.return_distance = 0.0

        self.publisher = self.create_publisher(Twist, '/cmd_vel', 10)
        self.create_subscription(
            Odometry,
            '/ground_truth/odom',
            lambda message: self.store_pose('truth', message),
            20,
        )
        self.create_subscription(
            Odometry,
            '/odom',
            lambda message: self.store_pose('wheel', message),
            20,
        )
        self.create_subscription(
            Odometry,
            '/custom_slam/laser_odom',
            self.matcher_callback,
            20,
        )
        self.create_subscription(
            DiagnosticArray,
            '/custom_slam/matcher_diagnostics',
            self.matcher_diagnostics_callback,
            100,
        )
        map_qos = QoSProfile(
            depth=1,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
        )
        self.create_subscription(
            OccupancyGrid,
            '/custom_slam/map',
            self.map_callback,
            map_qos,
        )
        self.create_subscription(
            Path,
            '/custom_slam/pose_graph_path',
            self.pose_graph_path_callback,
            10,
        )
        self.create_subscription(Log, '/rosout', self.log_callback, 100)

    def store_pose(self, name, message):
        self.poses[name] = pose_from_odometry(message)

    def matcher_callback(self, message):
        self.store_pose('matcher', message)
        stamp = stamp_to_seconds(message.header.stamp)
        if self.matcher_stamp is not None and stamp > self.matcher_stamp:
            self.maximum_matcher_gap = max(
                self.maximum_matcher_gap,
                stamp - self.matcher_stamp,
            )
        self.matcher_stamp = stamp
        if not self.measuring or self.starts is None:
            return
        if 'truth' not in self.poses:
            return

        truth = relative_pose(self.starts['truth'], self.poses['truth'])
        matcher = relative_pose(
            self.starts['matcher'],
            self.poses['matcher'],
        )
        self.maximum_longitudinal_error = max(
            self.maximum_longitudinal_error,
            abs(matcher[0] - truth[0]),
        )
        self.maximum_lateral_error = max(
            self.maximum_lateral_error,
            abs(matcher[1] - truth[1]),
        )
        self.maximum_yaw_error = max(
            self.maximum_yaw_error,
            abs(normalize_angle(matcher[2] - truth[2])),
        )
        covariance_xx = message.pose.covariance[0]
        covariance_xy = message.pose.covariance[1]
        covariance_yy = message.pose.covariance[7]
        trace = covariance_xx + covariance_yy
        discriminant = math.hypot(
            covariance_xx - covariance_yy,
            2.0 * covariance_xy,
        )
        maximum_variance = 0.5 * (trace + discriminant)
        minimum_variance = 0.5 * (trace - discriminant)
        covariance_ratio = maximum_variance / max(minimum_variance, 1.0e-12)
        self.maximum_covariance_ratio = max(
            self.maximum_covariance_ratio,
            covariance_ratio,
        )
        if covariance_ratio >= self.arguments.minimum_covariance_ratio:
            self.degenerate_covariance_samples += 1
        elif (
            maximum_variance
            <= self.arguments.maximum_regular_translation_stddev ** 2
        ):
            self.regular_covariance_samples += 1
        self.samples += 1

    def matcher_diagnostics_callback(self, message):
        for status in message.status:
            if status.name != MATCHER_DIAGNOSTIC_NAME:
                continue
            values = {entry.key: entry.value for entry in status.values}
            try:
                self.latest_diagnostic_counters = {
                    name: int(values[name])
                    for name in DIAGNOSTIC_COUNTER_NAMES
                }
                if self.measuring and status.message.startswith('match_'):
                    rank = int(values['translation_observable_rank'])
                    self.match_information_ratios.append(
                        float(values['translation_information_ratio'])
                    )
                    angle = float(
                        values['weak_translation_direction_angle_rad']
                    )
                    undirected_angle = (
                        (angle + 0.5 * math.pi) % math.pi
                    ) - 0.5 * math.pi
                    self.weak_direction_angles.append(undirected_angle)
                    if self.starts is not None and 'truth' in self.poses:
                        truth = relative_pose(
                            self.starts['truth'],
                            self.poses['truth'],
                        )
                        margin = self.arguments.degenerate_segment_margin
                        if (
                            margin <= truth[0]
                            <= self.arguments.distance - margin
                        ):
                            self.degenerate_segment_matches += 1
                            if rank < 2:
                                self.degenerate_segment_detections += 1
            except (KeyError, ValueError):
                self.malformed_diagnostics += 1

    def diagnostic_count(self, name):
        if (
            self.latest_diagnostic_counters is None
            or self.diagnostic_baseline is None
        ):
            return 0
        return max(
            0,
            self.latest_diagnostic_counters[name]
            - self.diagnostic_baseline[name],
        )

    def map_callback(self, message):
        self.latest_map = {
            'width': message.info.width,
            'height': message.info.height,
            'resolution': message.info.resolution,
        }
        self.map_messages += 1

    def pose_graph_path_callback(self, message):
        self.maximum_pose_graph_nodes = max(
            self.maximum_pose_graph_nodes,
            len(message.poses),
        )

    def log_callback(self, message):
        if message.name != 'scan_matcher_odometry':
            return
        if 'Accepted loop closure' in message.msg:
            match = LOOP_CLOSURE_PATTERN.search(message.msg)
            if match is None:
                self.critical_logs.append(
                    f'Malformed accepted loop closure log: {message.msg}'
                )
            else:
                self.loop_closures.append(
                    {
                        'candidate': int(match.group(1)),
                        'current': int(match.group(2)),
                        'rank': int(match.group(3)),
                        'minimum_translation_information': float(
                            match.group(4)
                        ),
                        'maximum_translation_information': float(
                            match.group(5)
                        ),
                    }
                )
        if 'Completed occupancy grid rebuild' in message.msg:
            self.map_rebuilds.append(message.msg)
        if 'Correlative match rejected' in message.msg:
            self.match_rejection_warnings += 1
        if any(
            fragment in message.msg
            for fragment in CRITICAL_LOG_FRAGMENTS
        ):
            self.critical_logs.append(message.msg)

    def simulation_time(self):
        return self.get_clock().now().nanoseconds * 1.0e-9

    def wait_for_inputs(self, timeout):
        required_poses = {'truth', 'wheel', 'matcher'}
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            rclpy.spin_once(self, timeout_sec=0.1)
            if (
                required_poses.issubset(self.poses)
                and self.latest_map is not None
                and self.latest_diagnostic_counters is not None
            ):
                return
        raise RuntimeError(
            'Timed out waiting for odometry, map and matcher diagnostics'
        )

    def publish_command(self, linear, angular=0.0):
        command = Twist()
        command.linear.x = linear
        command.angular.z = angular
        self.publisher.publish(command)

    def settle(self, seconds):
        started = self.simulation_time()
        wall_started = time.monotonic()
        wall_timeout = seconds * 5.0 + 10.0
        while rclpy.ok() and self.simulation_time() - started < seconds:
            if time.monotonic() - wall_started > wall_timeout:
                raise RuntimeError(
                    'Settle phase timed out while simulation time stalled'
                )
            self.publish_command(0.0)
            rclpy.spin_once(self, timeout_sec=0.05)

    def drive_leg(self, start_truth, target_yaw, arguments, label):
        wall_started = time.monotonic()
        wall_timeout = arguments.distance / arguments.linear_speed * 5.0 + 30.0
        next_report = arguments.report_interval
        while rclpy.ok():
            truth = relative_pose(start_truth, self.poses['truth'])
            if truth[0] >= arguments.distance:
                break
            if time.monotonic() - wall_started > wall_timeout:
                raise RuntimeError(
                    'Corridor traversal timed out before reaching the target'
                )
            heading_error = normalize_angle(
                target_yaw - self.poses['truth'][2]
            )
            angular_correction = max(
                -arguments.maximum_heading_correction,
                min(
                    arguments.maximum_heading_correction,
                    arguments.heading_control_gain * heading_error,
                ),
            )
            self.publish_command(
                arguments.linear_speed,
                angular_correction,
            )
            rclpy.spin_once(self, timeout_sec=0.025)
            if truth[0] >= next_report:
                print(
                    f'  {label}: {truth[0]:.1f}/{arguments.distance:.1f} m, '
                    f'lateral={self.maximum_lateral_error:.3f} m, '
                    f'yaw={math.degrees(self.maximum_yaw_error):.2f} deg, '
                    f'nodes={self.maximum_pose_graph_nodes}',
                    flush=True,
                )
                next_report += arguments.report_interval
        self.publish_command(0.0)
        return relative_pose(start_truth, self.poses['truth'])[0]

    def rotate_in_place(self, angle, angular_speed):
        direction = 1.0 if angle >= 0.0 else -1.0
        commanded_speed = direction * abs(angular_speed)
        target_rotation = abs(angle)
        accumulated_rotation = 0.0
        previous_yaw = self.poses['truth'][2]
        wall_started = time.monotonic()
        wall_timeout = target_rotation / abs(angular_speed) * 5.0 + 30.0
        while rclpy.ok() and accumulated_rotation < target_rotation:
            if time.monotonic() - wall_started > wall_timeout:
                raise RuntimeError(
                    'Corridor U-turn timed out before reaching the target'
                )
            self.publish_command(0.0, commanded_speed)
            rclpy.spin_once(self, timeout_sec=0.025)
            current_yaw = self.poses['truth'][2]
            yaw_step = normalize_angle(current_yaw - previous_yaw)
            if yaw_step * direction > 0.0:
                accumulated_rotation += abs(yaw_step)
            previous_yaw = current_yaw
        self.publish_command(0.0)
        return accumulated_rotation

    def evaluate(self, arguments):
        motions = {
            name: relative_pose(self.starts[name], self.poses[name])
            for name in self.starts
        }
        truth = motions['truth']
        matcher = motions['matcher']
        wheel = motions['wheel']
        final_longitudinal_error = abs(matcher[0] - truth[0])
        final_lateral_error = abs(matcher[1] - truth[1])
        final_yaw_error = abs(normalize_angle(matcher[2] - truth[2]))
        wheel_longitudinal_error = abs(wheel[0] - truth[0])
        wheel_lateral_error = abs(wheel[1] - truth[1])
        wheel_yaw_error = abs(normalize_angle(wheel[2] - truth[2]))
        map_width = (
            self.latest_map['width'] * self.latest_map['resolution']
        )
        map_height = (
            self.latest_map['height'] * self.latest_map['resolution']
        )
        maximum_longitudinal_drift = (
            arguments.maximum_return_longitudinal_drift
            if arguments.return_trip
            else arguments.maximum_longitudinal_drift
        )
        match_attempts = self.diagnostic_count('match_attempts')
        accepted_matches = self.diagnostic_count('accepted_matches')
        rejected_matches = self.diagnostic_count('rejected_matches')
        rank_counts = (
            self.diagnostic_count('rank_zero_matches'),
            self.diagnostic_count('rank_one_matches'),
            self.diagnostic_count('rank_two_matches'),
        )
        suppressed_matches = self.diagnostic_count('suppressed_matches')
        motion_below_threshold = self.diagnostic_count(
            'motion_below_threshold_scans'
        )
        degenerate_detection_fraction = (
            self.degenerate_segment_detections
            / max(self.degenerate_segment_matches, 1)
        )
        rank_one_loop_closures = [
            event for event in self.loop_closures
            if event['rank'] == 1
        ]
        anisotropic_rank_one_loop_closures = [
            event for event in rank_one_loop_closures
            if event['maximum_translation_information'] > 0.0
            and event['minimum_translation_information']
            / event['maximum_translation_information']
            <= arguments.maximum_anisotropic_loop_information_ratio
        ]

        checks = {
            'outbound_distance_reached': (
                self.outbound_distance >= arguments.distance
            ),
            'continuous_lateral_error_bounded': (
                self.maximum_lateral_error
                <= arguments.maximum_lateral_error
            ),
            'continuous_yaw_error_bounded': (
                self.maximum_yaw_error
                <= math.radians(arguments.maximum_yaw_error_degrees)
            ),
            'longitudinal_drift_not_runaway': (
                self.maximum_longitudinal_error
                <= maximum_longitudinal_drift
            ),
            'final_lateral_error_bounded': (
                final_lateral_error
                <= arguments.maximum_final_lateral_error
            ),
            'final_yaw_error_bounded': (
                final_yaw_error
                <= math.radians(arguments.maximum_final_yaw_error_degrees)
            ),
            'front_end_gap_bounded': (
                self.maximum_matcher_gap
                <= arguments.maximum_matcher_gap
            ),
            'match_rejections_bounded': (
                self.match_rejection_warnings
                <= arguments.maximum_match_rejections
            ),
            'loop_closure_behavior_valid': (
                len(self.loop_closures) >= arguments.minimum_loop_closures
                if arguments.return_trip else not self.loop_closures
            ),
            'map_rebuild_behavior_valid': (
                len(self.map_rebuilds) >= arguments.minimum_map_rebuilds
                if arguments.return_trip else not self.map_rebuilds
            ),
            'pose_graph_long_enough': (
                self.maximum_pose_graph_nodes
                >= arguments.minimum_keyframes
            ),
            'map_length_covered': map_width >= arguments.minimum_map_length,
            'map_cross_track_bounded': (
                map_height <= arguments.maximum_map_width
            ),
            'no_critical_slam_logs': not self.critical_logs,
            'enough_error_samples': self.samples >= arguments.minimum_samples,
            'enough_real_match_attempts': (
                match_attempts >= arguments.minimum_match_attempts
            ),
            'match_diagnostic_counts_consistent': (
                match_attempts == accepted_matches + rejected_matches
                and match_attempts == sum(rank_counts)
            ),
            'match_diagnostics_well_formed': (
                self.malformed_diagnostics == 0
            ),
            'degenerate_segment_sampled': (
                self.degenerate_segment_matches
                >= arguments.minimum_degenerate_segment_matches
            ),
            'degenerate_segment_detection_rate': (
                degenerate_detection_fraction
                >= arguments.minimum_degenerate_detection_fraction
            ),
        }
        if arguments.return_trip:
            checks.update(
                {
                    'return_distance_reached': (
                        self.return_distance >= arguments.distance
                    ),
                    'truth_return_position_closed': (
                        math.hypot(truth[0], truth[1])
                        <= arguments.maximum_truth_return_error
                    ),
                    'matcher_return_position_accurate': (
                        math.hypot(
                            matcher[0] - truth[0],
                            matcher[1] - truth[1],
                        ) <= arguments.maximum_final_translation_error
                    ),
                    'return_pose_graph_long_enough': (
                        self.maximum_pose_graph_nodes
                        >= arguments.minimum_return_keyframes
                    ),
                }
            )
        if arguments.expect_anisotropic_loop_closure:
            checks.update(
                {
                    'rank_one_loop_closure_accepted': bool(
                        rank_one_loop_closures
                    ),
                    'rank_one_loop_information_anisotropic': bool(
                        anisotropic_rank_one_loop_closures
                    ),
                }
            )

        print('\ndegenerate corridor result')
        print(
            f'truth motion : x={truth[0]:.3f} y={truth[1]:.3f} '
            f'yaw={math.degrees(truth[2]):.3f} deg'
        )
        print(
            'wheel error  : '
            f'longitudinal={wheel_longitudinal_error:.3f} m '
            f'lateral={wheel_lateral_error:.3f} m '
            f'yaw={math.degrees(wheel_yaw_error):.3f} deg'
        )
        print(
            'matcher final: '
            f'longitudinal={final_longitudinal_error:.3f} m '
            f'lateral={final_lateral_error:.3f} m '
            f'yaw={math.degrees(final_yaw_error):.3f} deg'
        )
        print(
            'matcher peak : '
            f'longitudinal={self.maximum_longitudinal_error:.3f} m '
            f'lateral={self.maximum_lateral_error:.3f} m '
            f'yaw={math.degrees(self.maximum_yaw_error):.3f} deg'
        )
        print(
            f'front end   : gap={self.maximum_matcher_gap:.3f} s '
            f'samples={self.samples} '
            f'keyframes={self.maximum_pose_graph_nodes} '
            f'rejections={self.match_rejection_warnings} '
            f'loops={len(self.loop_closures)} '
            f'rebuilds={len(self.map_rebuilds)}'
        )
        if self.loop_closures:
            loop_information_ratios = [
                event['minimum_translation_information']
                / event['maximum_translation_information']
                for event in self.loop_closures
                if event['maximum_translation_information'] > 0.0
            ]
            print(
                'loop info   : '
                f'ranks={[event["rank"] for event in self.loop_closures]} '
                'ratios=['
                + ', '.join(
                    f'{ratio:.4f}' for ratio in loop_information_ratios
                )
                + ']'
            )
        print(
            f'covariance  : max_ratio={self.maximum_covariance_ratio:.1f} '
            f'degenerate_samples={self.degenerate_covariance_samples} '
            f'regular_samples={self.regular_covariance_samples} '
            '(odometry messages, not match events)'
        )
        print(
            f'diagnostics : attempts={match_attempts} '
            f'accepted={accepted_matches} rejected={rejected_matches} '
            f'rank=[{rank_counts[0]}, {rank_counts[1]}, {rank_counts[2]}] '
            f'suppressed={suppressed_matches} '
            f'below_motion={motion_below_threshold} '
            f'malformed={self.malformed_diagnostics}'
        )
        print(
            'degenerate  : '
            f'segment_matches={self.degenerate_segment_matches} '
            f'detections={self.degenerate_segment_detections} '
            f'fraction={degenerate_detection_fraction:.3f}'
        )
        ratio_boundaries = (0.0, 0.01, 0.025, 0.05, 0.10, 0.25, 0.50, 1.0)
        angle_boundaries = tuple(
            math.radians(value) for value in (-90, -60, -30, 0, 30, 60, 90)
        )
        print(
            'ratio hist  : '
            f'edges={ratio_boundaries} '
            f'counts={histogram(self.match_information_ratios, ratio_boundaries)}'
        )
        print(
            'weak angle  : edges_deg=(-90, -60, -30, 0, 30, 60, 90) '
            f'counts={histogram(self.weak_direction_angles, angle_boundaries)}'
        )
        print(
            f'route legs  : outbound={self.outbound_distance:.3f} m '
            f'return={self.return_distance:.3f} m'
        )
        print(
            f'map extent  : {map_width:.2f} x {map_height:.2f} m '
            f'({self.map_messages} messages)'
        )
        for name, passed in checks.items():
            print(f"  [{'PASS' if passed else 'FAIL'}] {name}")
        return all(checks.values())

    def run(self, arguments):
        self.arguments = arguments
        self.wait_for_inputs(arguments.startup_timeout)
        self.settle(arguments.initial_settle_time)
        self.starts = dict(self.poses)
        self.diagnostic_baseline = dict(self.latest_diagnostic_counters)
        self.match_information_ratios.clear()
        self.weak_direction_angles.clear()
        self.matcher_stamp = None
        self.maximum_matcher_gap = 0.0
        self.measuring = True
        print(
            f'driving outbound {arguments.distance:.1f} m at '
            f'{arguments.linear_speed:.2f} m/s',
            flush=True,
        )
        self.outbound_distance = self.drive_leg(
            self.starts['truth'],
            self.starts['truth'][2],
            arguments,
            'outbound',
        )
        if arguments.return_trip:
            self.settle(arguments.turn_settle_time)
            print(
                f'turning 180 deg at {arguments.angular_speed:.2f} rad/s',
                flush=True,
            )
            actual_turn = self.rotate_in_place(
                math.pi,
                arguments.angular_speed,
            )
            self.settle(arguments.turn_settle_time)
            return_start = self.poses['truth']
            print(
                f'driving return {arguments.distance:.1f} m at '
                f'{arguments.linear_speed:.2f} m/s '
                f'(turn={math.degrees(actual_turn):.2f} deg)',
                flush=True,
            )
            self.return_distance = self.drive_leg(
                return_start,
                normalize_angle(self.starts['truth'][2] + math.pi),
                arguments,
                'return',
            )
        self.settle(arguments.final_settle_time)
        self.measuring = False
        passed = self.evaluate(arguments)
        print(
            f"\ncorridor {'return ' if arguments.return_trip else ''}"
            f"regression: {'PASS' if passed else 'FAIL'}"
        )
        return passed


def parse_arguments():
    parser = argparse.ArgumentParser(
        description='Run a custom-SLAM degenerate-corridor regression.'
    )
    parser.add_argument('--distance', type=float, default=25.0)
    parser.add_argument('--linear-speed', type=float, default=0.40)
    parser.add_argument('--return-trip', action='store_true')
    parser.add_argument(
        '--expect-anisotropic-loop-closure',
        action='store_true',
        help=(
            'Require a rank-one accepted loop with anisotropic information. '
            'Use with reject_degenerate_loop_closures:=false.'
        ),
    )
    parser.add_argument(
        '--maximum-anisotropic-loop-information-ratio',
        type=float,
        default=0.10,
    )
    parser.add_argument('--angular-speed', type=float, default=0.40)
    parser.add_argument('--heading-control-gain', type=float, default=2.0)
    parser.add_argument(
        '--maximum-heading-correction',
        type=float,
        default=0.20,
    )
    parser.add_argument('--initial-settle-time', type=float, default=2.0)
    parser.add_argument('--turn-settle-time', type=float, default=2.0)
    parser.add_argument('--final-settle-time', type=float, default=3.0)
    parser.add_argument('--startup-timeout', type=float, default=15.0)
    parser.add_argument('--report-interval', type=float, default=5.0)
    parser.add_argument('--maximum-matcher-gap', type=float, default=0.25)
    parser.add_argument('--maximum-lateral-error', type=float, default=0.10)
    parser.add_argument(
        '--maximum-yaw-error-degrees',
        type=float,
        default=2.0,
    )
    parser.add_argument(
        '--maximum-longitudinal-drift',
        type=float,
        default=0.25,
    )
    parser.add_argument(
        '--maximum-return-longitudinal-drift',
        type=float,
        default=0.30,
    )
    parser.add_argument(
        '--maximum-final-lateral-error',
        type=float,
        default=0.08,
    )
    parser.add_argument(
        '--maximum-final-yaw-error-degrees',
        type=float,
        default=1.0,
    )
    parser.add_argument('--maximum-match-rejections', type=int, default=2)
    parser.add_argument('--minimum-keyframes', type=int, default=200)
    parser.add_argument('--minimum-return-keyframes', type=int, default=550)
    parser.add_argument('--minimum-loop-closures', type=int, default=1)
    parser.add_argument('--minimum-map-rebuilds', type=int, default=1)
    parser.add_argument('--maximum-truth-return-error', type=float, default=0.25)
    parser.add_argument(
        '--maximum-final-translation-error',
        type=float,
        default=0.15,
    )
    parser.add_argument('--minimum-map-length', type=float, default=28.0)
    parser.add_argument('--maximum-map-width', type=float, default=4.0)
    parser.add_argument('--minimum-samples', type=int, default=500)
    parser.add_argument('--minimum-match-attempts', type=int, default=100)
    parser.add_argument('--degenerate-segment-margin', type=float, default=5.0)
    parser.add_argument(
        '--minimum-degenerate-segment-matches',
        type=int,
        default=100,
    )
    parser.add_argument(
        '--minimum-degenerate-detection-fraction',
        type=float,
        default=0.90,
    )
    parser.add_argument('--minimum-covariance-ratio', type=float, default=10.0)
    parser.add_argument(
        '--maximum-regular-translation-stddev',
        type=float,
        default=0.10,
    )
    arguments, ros_arguments = parser.parse_known_args()
    if ros_arguments:
        sys.argv = [sys.argv[0], *ros_arguments]
    numeric_values = (
        arguments.distance,
        arguments.linear_speed,
        arguments.angular_speed,
        arguments.heading_control_gain,
        arguments.maximum_heading_correction,
        arguments.startup_timeout,
        arguments.report_interval,
        arguments.maximum_matcher_gap,
        arguments.maximum_lateral_error,
        arguments.maximum_yaw_error_degrees,
        arguments.maximum_longitudinal_drift,
        arguments.maximum_return_longitudinal_drift,
        arguments.maximum_final_lateral_error,
        arguments.maximum_final_yaw_error_degrees,
        arguments.maximum_truth_return_error,
        arguments.maximum_final_translation_error,
        arguments.minimum_map_length,
        arguments.maximum_map_width,
        arguments.minimum_covariance_ratio,
        arguments.maximum_regular_translation_stddev,
        arguments.degenerate_segment_margin,
        arguments.minimum_degenerate_detection_fraction,
        arguments.maximum_anisotropic_loop_information_ratio,
    )
    if (
        any(not math.isfinite(value) or value <= 0.0 for value in numeric_values)
        or arguments.initial_settle_time < 0.0
        or arguments.turn_settle_time < 0.0
        or arguments.final_settle_time < 0.0
        or arguments.maximum_match_rejections < 0
        or arguments.minimum_keyframes < 1
        or arguments.minimum_return_keyframes < 1
        or arguments.minimum_loop_closures < 1
        or arguments.minimum_map_rebuilds < 1
        or arguments.minimum_samples < 1
        or arguments.minimum_match_attempts < 1
        or arguments.minimum_degenerate_segment_matches < 1
        or arguments.minimum_covariance_ratio <= 1.0
        or arguments.degenerate_segment_margin * 2.0
        >= arguments.distance
        or arguments.minimum_degenerate_detection_fraction > 1.0
        or arguments.maximum_anisotropic_loop_information_ratio > 1.0
    ):
        parser.error('Distances, speeds, timeouts and thresholds must be valid')
    return arguments


def main():
    arguments = parse_arguments()
    rclpy.init()
    node = CorridorRegression()
    exit_code = 1
    try:
        exit_code = 0 if node.run(arguments) else 1
    except (KeyboardInterrupt, RuntimeError) as error:
        print(f'corridor regression failed: {error}', file=sys.stderr)
    finally:
        node.publish_command(0.0)
        node.destroy_node()
        rclpy.shutdown()
    raise SystemExit(exit_code)


if __name__ == '__main__':
    main()
