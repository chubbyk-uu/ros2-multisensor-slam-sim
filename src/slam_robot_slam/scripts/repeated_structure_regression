#!/usr/bin/env python3

"""Test false-loop protection in two visually similar rooms."""

import argparse
from bisect import bisect_left
import math
import re
import sys
import time

from geometry_msgs.msg import Twist
from nav_msgs.msg import OccupancyGrid, Odometry, Path
from rcl_interfaces.msg import Log
import rclpy
from rclpy.node import Node
from rclpy.parameter import Parameter
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy


LOOP_CLOSURE_PATTERN = re.compile(
    r'Accepted loop closure (\d+) -> (\d+): score=([\d.]+)'
)
MAP_REBUILD_PATTERN = re.compile(
    r'Completed occupancy grid rebuild from (\d+) optimized keyframes'
)
CRITICAL_LOG_FRAGMENTS = (
    'Aborted occupancy grid rebuild',
    'Aborted queued occupancy grid rebuild',
    'Discarded incompatible loop closure result',
    'Failed to create occupancy grid snapshot',
    'Failed to start loop closure worker',
    'Fatal SLAM node error',
    'Loop closure committed but occupancy grid rebuild failed to start',
    'Loop closure committed but pose graph path refresh failed',
    'Loop closure worker failed',
    'Rejected LaserScan after processing error',
)


def yaw_from_quaternion(orientation):
    sin_yaw = 2.0 * (
        orientation.w * orientation.z
        + orientation.x * orientation.y
    )
    cos_yaw = 1.0 - 2.0 * (
        orientation.y * orientation.y
        + orientation.z * orientation.z
    )
    return math.atan2(sin_yaw, cos_yaw)


def normalize_angle(angle):
    return math.atan2(math.sin(angle), math.cos(angle))


def stamp_to_seconds(stamp):
    return float(stamp.sec) + float(stamp.nanosec) * 1.0e-9


def pose_from_odometry(message):
    position = message.pose.pose.position
    return (
        position.x,
        position.y,
        yaw_from_quaternion(message.pose.pose.orientation),
    )


def relative_pose(start, finish):
    dx = finish[0] - start[0]
    dy = finish[1] - start[1]
    cosine = math.cos(start[2])
    sine = math.sin(start[2])
    return (
        cosine * dx + sine * dy,
        -sine * dx + cosine * dy,
        normalize_angle(finish[2] - start[2]),
    )


def interpolate_pose(first, second, ratio):
    yaw_delta = normalize_angle(second[2] - first[2])
    return (
        first[0] + ratio * (second[0] - first[0]),
        first[1] + ratio * (second[1] - first[1]),
        normalize_angle(first[2] + ratio * yaw_delta),
    )


class RepeatedStructureRegression(Node):
    def __init__(self):
        super().__init__(
            'repeated_structure_regression',
            parameter_overrides=[
                Parameter('use_sim_time', value=True),
            ],
        )
        self.poses = {}
        self.starts = None
        self.truth_history = []
        self.truth_history_stamps = []
        self.pose_graph_stamps = []
        self.maximum_pose_graph_nodes = 0
        self.loop_closures = []
        self.map_rebuilds = []
        self.outbound_loop_closures = 0
        self.match_rejection_warnings = 0
        self.critical_logs = []
        self.latest_map = None
        self.map_messages = 0
        self.matcher_stamp = None
        self.maximum_matcher_gap = 0.0
        self.measuring = False
        self.samples = 0
        self.maximum_translation_error = 0.0
        self.maximum_yaw_error = 0.0
        self.outbound_distance = 0.0
        self.return_distance = 0.0

        self.publisher = self.create_publisher(Twist, '/cmd_vel', 10)
        self.create_subscription(
            Odometry,
            '/ground_truth/odom',
            self.truth_callback,
            50,
        )
        self.create_subscription(
            Odometry,
            '/odom',
            lambda message: self.store_pose('wheel', message),
            50,
        )
        self.create_subscription(
            Odometry,
            '/custom_slam/laser_odom',
            self.matcher_callback,
            20,
        )
        map_qos = QoSProfile(
            depth=1,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
        )
        self.create_subscription(
            OccupancyGrid,
            '/custom_slam/map',
            self.map_callback,
            map_qos,
        )
        self.create_subscription(
            Path,
            '/custom_slam/pose_graph_path',
            self.pose_graph_path_callback,
            10,
        )
        self.create_subscription(Log, '/rosout', self.log_callback, 100)

    def store_pose(self, name, message):
        self.poses[name] = pose_from_odometry(message)

    def truth_callback(self, message):
        pose = pose_from_odometry(message)
        self.poses['truth'] = pose
        stamp = stamp_to_seconds(message.header.stamp)
        if not self.truth_history_stamps or stamp > self.truth_history_stamps[-1]:
            self.truth_history_stamps.append(stamp)
            self.truth_history.append(pose)

    def matcher_callback(self, message):
        self.store_pose('matcher', message)
        stamp = stamp_to_seconds(message.header.stamp)
        if self.matcher_stamp is not None and stamp > self.matcher_stamp:
            self.maximum_matcher_gap = max(
                self.maximum_matcher_gap,
                stamp - self.matcher_stamp,
            )
        self.matcher_stamp = stamp
        if not self.measuring or self.starts is None:
            return
        truth = relative_pose(self.starts['truth'], self.poses['truth'])
        matcher = relative_pose(
            self.starts['matcher'],
            self.poses['matcher'],
        )
        self.maximum_translation_error = max(
            self.maximum_translation_error,
            math.hypot(matcher[0] - truth[0], matcher[1] - truth[1]),
        )
        self.maximum_yaw_error = max(
            self.maximum_yaw_error,
            abs(normalize_angle(matcher[2] - truth[2])),
        )
        self.samples += 1

    def map_callback(self, message):
        self.latest_map = {
            'width': message.info.width,
            'height': message.info.height,
            'resolution': message.info.resolution,
        }
        self.map_messages += 1

    def pose_graph_path_callback(self, message):
        self.pose_graph_stamps = [
            stamp_to_seconds(pose.header.stamp)
            for pose in message.poses
        ]
        self.maximum_pose_graph_nodes = max(
            self.maximum_pose_graph_nodes,
            len(message.poses),
        )

    def log_callback(self, message):
        if message.name != 'scan_matcher_odometry':
            return
        loop_match = LOOP_CLOSURE_PATTERN.search(message.msg)
        if loop_match:
            event = {
                'candidate': int(loop_match.group(1)),
                'current': int(loop_match.group(2)),
                'score': float(loop_match.group(3)),
            }
            self.loop_closures.append(event)
            print(
                f"  loop closure: {event['candidate']} -> "
                f"{event['current']} score={event['score']:.3f}",
                flush=True,
            )
        rebuild_match = MAP_REBUILD_PATTERN.search(message.msg)
        if rebuild_match:
            self.map_rebuilds.append(int(rebuild_match.group(1)))
        if 'Correlative match rejected' in message.msg:
            self.match_rejection_warnings += 1
        if any(
            fragment in message.msg
            for fragment in CRITICAL_LOG_FRAGMENTS
        ):
            self.critical_logs.append(message.msg)

    def simulation_time(self):
        return self.get_clock().now().nanoseconds * 1.0e-9

    def wait_for_inputs(self, timeout):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            rclpy.spin_once(self, timeout_sec=0.1)
            if (
                len(self.poses) == 3
                and self.latest_map is not None
            ):
                return
        raise RuntimeError(
            'Timed out waiting for odometry and map topics'
        )

    def publish_command(self, linear, angular=0.0):
        command = Twist()
        command.linear.x = linear
        command.angular.z = angular
        self.publisher.publish(command)

    def settle(self, seconds):
        started = self.simulation_time()
        wall_started = time.monotonic()
        wall_timeout = seconds * 5.0 + 10.0
        while rclpy.ok() and self.simulation_time() - started < seconds:
            if time.monotonic() - wall_started > wall_timeout:
                raise RuntimeError(
                    'Settle phase timed out while simulation time stalled'
                )
            self.publish_command(0.0)
            rclpy.spin_once(self, timeout_sec=0.05)

    def drive_leg(self, start_truth, target_yaw, arguments, label):
        wall_started = time.monotonic()
        wall_timeout = arguments.distance / arguments.linear_speed * 5.0 + 30.0
        next_report = arguments.report_interval
        while rclpy.ok():
            truth = relative_pose(start_truth, self.poses['truth'])
            if truth[0] >= arguments.distance:
                break
            if time.monotonic() - wall_started > wall_timeout:
                raise RuntimeError(f'{label} traversal timed out')
            heading_error = normalize_angle(
                target_yaw - self.poses['truth'][2]
            )
            angular = max(
                -arguments.maximum_heading_correction,
                min(
                    arguments.maximum_heading_correction,
                    arguments.heading_control_gain * heading_error,
                ),
            )
            self.publish_command(arguments.linear_speed, angular)
            rclpy.spin_once(self, timeout_sec=0.025)
            if truth[0] >= next_report:
                print(
                    f'  {label}: {truth[0]:.1f}/{arguments.distance:.1f} m, '
                    f'loops={len(self.loop_closures)}, '
                    f'nodes={self.maximum_pose_graph_nodes}',
                    flush=True,
                )
                next_report += arguments.report_interval
        self.publish_command(0.0)
        return relative_pose(start_truth, self.poses['truth'])[0]

    def rotate_in_place(self, angular_speed):
        direction = 1.0 if angular_speed > 0.0 else -1.0
        accumulated = 0.0
        previous_yaw = self.poses['truth'][2]
        wall_started = time.monotonic()
        wall_timeout = math.pi / abs(angular_speed) * 5.0 + 30.0
        while rclpy.ok() and accumulated < math.pi:
            if time.monotonic() - wall_started > wall_timeout:
                raise RuntimeError('Room-B U-turn timed out')
            self.publish_command(0.0, angular_speed)
            rclpy.spin_once(self, timeout_sec=0.025)
            current_yaw = self.poses['truth'][2]
            step = normalize_angle(current_yaw - previous_yaw)
            if step * direction > 0.0:
                accumulated += abs(step)
            previous_yaw = current_yaw
        self.publish_command(0.0)

    def truth_pose_at(self, stamp):
        if not self.truth_history_stamps or self.starts is None:
            return None
        index = bisect_left(self.truth_history_stamps, stamp)
        if index == 0:
            return self.starts['truth']
        if index >= len(self.truth_history_stamps):
            return self.truth_history[-1]
        first_stamp = self.truth_history_stamps[index - 1]
        second_stamp = self.truth_history_stamps[index]
        if second_stamp <= first_stamp:
            return self.truth_history[index]
        ratio = (stamp - first_stamp) / (second_stamp - first_stamp)
        return interpolate_pose(
            self.truth_history[index - 1],
            self.truth_history[index],
            ratio,
        )

    def classify_loop_closures(self, maximum_true_distance):
        classified = []
        for event in self.loop_closures:
            if (
                event['candidate'] >= len(self.pose_graph_stamps)
                or event['current'] >= len(self.pose_graph_stamps)
            ):
                classified.append({**event, 'truth_distance': None})
                continue
            candidate = self.truth_pose_at(
                self.pose_graph_stamps[event['candidate']]
            )
            current = self.truth_pose_at(
                self.pose_graph_stamps[event['current']]
            )
            if candidate is None or current is None:
                classified.append({**event, 'truth_distance': None})
                continue
            distance = math.hypot(
                current[0] - candidate[0],
                current[1] - candidate[1],
            )
            classified.append(
                {
                    **event,
                    'truth_distance': distance,
                    'is_true': distance <= maximum_true_distance,
                }
            )
        return classified

    def evaluate(self, arguments):
        motions = {
            name: relative_pose(self.starts[name], self.poses[name])
            for name in self.starts
        }
        truth = motions['truth']
        matcher = motions['matcher']
        wheel = motions['wheel']
        final_translation_error = math.hypot(
            matcher[0] - truth[0],
            matcher[1] - truth[1],
        )
        final_yaw_error = abs(normalize_angle(matcher[2] - truth[2]))
        wheel_translation_error = math.hypot(
            wheel[0] - truth[0],
            wheel[1] - truth[1],
        )
        wheel_yaw_error = abs(normalize_angle(wheel[2] - truth[2]))
        map_width = self.latest_map['width'] * self.latest_map['resolution']
        map_height = self.latest_map['height'] * self.latest_map['resolution']
        classified = self.classify_loop_closures(
            arguments.maximum_true_loop_distance
        )
        true_loops = [event for event in classified if event.get('is_true')]
        false_loops = [
            event
            for event in classified
            if event.get('is_true') is False
        ]
        unclassified = [
            event
            for event in classified
            if event['truth_distance'] is None
        ]

        checks = {
            'outbound_distance_reached': (
                self.outbound_distance >= arguments.distance
            ),
            'return_distance_reached': (
                self.return_distance >= arguments.distance
            ),
            'truth_return_position_closed': (
                math.hypot(truth[0], truth[1])
                <= arguments.maximum_truth_return_error
            ),
            'no_outbound_false_loop': self.outbound_loop_closures == 0,
            'true_loop_closure_accepted': (
                len(true_loops) >= arguments.minimum_true_loop_closures
            ),
            'no_false_loop_closure': not false_loops,
            'all_loop_closures_classified': not unclassified,
            'map_rebuild_completed': (
                len(self.map_rebuilds) >= arguments.minimum_map_rebuilds
            ),
            'continuous_translation_error_bounded': (
                self.maximum_translation_error
                <= arguments.maximum_translation_error
            ),
            'continuous_yaw_error_bounded': (
                self.maximum_yaw_error
                <= math.radians(arguments.maximum_yaw_error_degrees)
            ),
            'final_translation_error_bounded': (
                final_translation_error
                <= arguments.maximum_final_translation_error
            ),
            'final_yaw_error_bounded': (
                final_yaw_error
                <= math.radians(arguments.maximum_final_yaw_error_degrees)
            ),
            'front_end_gap_bounded': (
                self.maximum_matcher_gap <= arguments.maximum_matcher_gap
            ),
            'match_rejections_bounded': (
                self.match_rejection_warnings
                <= arguments.maximum_match_rejections
            ),
            'pose_graph_long_enough': (
                self.maximum_pose_graph_nodes >= arguments.minimum_keyframes
            ),
            'map_length_covered': map_width >= arguments.minimum_map_length,
            'map_width_bounded': map_height <= arguments.maximum_map_width,
            'map_published': self.map_messages >= arguments.minimum_map_messages,
            'enough_error_samples': self.samples >= arguments.minimum_samples,
            'no_critical_slam_logs': not self.critical_logs,
        }

        print('\nrepeated-structure regression result')
        print(
            f'truth motion : x={truth[0]:.3f} y={truth[1]:.3f} '
            f'yaw={math.degrees(truth[2]):.3f} deg'
        )
        print(
            f'wheel error : translation={wheel_translation_error:.3f} m '
            f'yaw={math.degrees(wheel_yaw_error):.3f} deg'
        )
        print(
            f'matcher     : final={final_translation_error:.3f} m / '
            f'{math.degrees(final_yaw_error):.3f} deg, '
            f'peak={self.maximum_translation_error:.3f} m / '
            f'{math.degrees(self.maximum_yaw_error):.3f} deg'
        )
        print(
            f'events      : outbound_loops={self.outbound_loop_closures} '
            f'true={len(true_loops)} false={len(false_loops)} '
            f'unclassified={len(unclassified)} '
            f'rebuilds={len(self.map_rebuilds)} '
            f'rejections={self.match_rejection_warnings}'
        )
        for event in classified:
            distance_text = (
                'unknown'
                if event['truth_distance'] is None
                else f"{event['truth_distance']:.3f} m"
            )
            print(
                f"  closure {event['candidate']} -> {event['current']}: "
                f"score={event['score']:.3f}, truth={distance_text}"
            )
        print(
            f'front end   : gap={self.maximum_matcher_gap:.3f} s '
            f'samples={self.samples} nodes={self.maximum_pose_graph_nodes}'
        )
        print(
            f'map extent  : {map_width:.2f} x {map_height:.2f} m '
            f'({self.map_messages} messages)'
        )
        for name, passed in checks.items():
            print(f"  [{'PASS' if passed else 'FAIL'}] {name}")
        return all(checks.values())

    def run(self, arguments):
        self.wait_for_inputs(arguments.startup_timeout)
        self.settle(arguments.initial_settle_time)
        self.starts = dict(self.poses)
        self.matcher_stamp = None
        self.maximum_matcher_gap = 0.0
        self.measuring = True

        print(
            f'driving from repeated room A to room B: '
            f'{arguments.distance:.1f} m',
            flush=True,
        )
        self.outbound_distance = self.drive_leg(
            self.starts['truth'],
            self.starts['truth'][2],
            arguments,
            'outbound',
        )
        self.settle(arguments.turn_settle_time)
        self.outbound_loop_closures = len(self.loop_closures)

        print('turning in room B and returning to room A', flush=True)
        self.rotate_in_place(abs(arguments.angular_speed))
        self.settle(arguments.turn_settle_time)
        return_start = self.poses['truth']
        self.return_distance = self.drive_leg(
            return_start,
            normalize_angle(self.starts['truth'][2] + math.pi),
            arguments,
            'return',
        )
        self.settle(arguments.final_settle_time)
        self.measuring = False
        passed = self.evaluate(arguments)
        print(
            f"\nrepeated-structure regression: "
            f"{'PASS' if passed else 'FAIL'}"
        )
        return passed


def parse_arguments():
    parser = argparse.ArgumentParser(
        description='Run the custom-SLAM repeated-structure regression.'
    )
    parser.add_argument('--distance', type=float, default=8.0)
    parser.add_argument('--linear-speed', type=float, default=0.30)
    parser.add_argument('--angular-speed', type=float, default=0.40)
    parser.add_argument('--heading-control-gain', type=float, default=2.0)
    parser.add_argument('--maximum-heading-correction', type=float, default=0.20)
    parser.add_argument('--initial-settle-time', type=float, default=2.0)
    parser.add_argument('--turn-settle-time', type=float, default=2.0)
    parser.add_argument('--final-settle-time', type=float, default=5.0)
    parser.add_argument('--startup-timeout', type=float, default=15.0)
    parser.add_argument('--report-interval', type=float, default=2.0)
    parser.add_argument('--maximum-matcher-gap', type=float, default=0.25)
    parser.add_argument('--maximum-translation-error', type=float, default=0.35)
    parser.add_argument('--maximum-yaw-error-degrees', type=float, default=3.0)
    parser.add_argument(
        '--maximum-final-translation-error',
        type=float,
        default=0.15,
    )
    parser.add_argument(
        '--maximum-final-yaw-error-degrees',
        type=float,
        default=2.0,
    )
    parser.add_argument('--maximum-truth-return-error', type=float, default=0.20)
    parser.add_argument('--maximum-true-loop-distance', type=float, default=0.80)
    parser.add_argument('--minimum-true-loop-closures', type=int, default=1)
    parser.add_argument('--minimum-map-rebuilds', type=int, default=1)
    parser.add_argument('--maximum-match-rejections', type=int, default=2)
    parser.add_argument('--minimum-keyframes', type=int, default=220)
    parser.add_argument('--minimum-map-length', type=float, default=12.0)
    parser.add_argument('--maximum-map-width', type=float, default=7.0)
    parser.add_argument('--minimum-map-messages', type=int, default=20)
    parser.add_argument('--minimum-samples', type=int, default=500)
    arguments, ros_arguments = parser.parse_known_args()
    if ros_arguments:
        sys.argv = [sys.argv[0], *ros_arguments]
    positive_values = (
        arguments.distance,
        arguments.linear_speed,
        abs(arguments.angular_speed),
        arguments.heading_control_gain,
        arguments.maximum_heading_correction,
        arguments.startup_timeout,
        arguments.report_interval,
        arguments.maximum_matcher_gap,
        arguments.maximum_translation_error,
        arguments.maximum_yaw_error_degrees,
        arguments.maximum_final_translation_error,
        arguments.maximum_final_yaw_error_degrees,
        arguments.maximum_truth_return_error,
        arguments.maximum_true_loop_distance,
        arguments.minimum_map_length,
        arguments.maximum_map_width,
    )
    if (
        any(not math.isfinite(value) or value <= 0.0 for value in positive_values)
        or arguments.initial_settle_time < 0.0
        or arguments.turn_settle_time < 0.0
        or arguments.final_settle_time < 0.0
        or arguments.minimum_true_loop_closures < 1
        or arguments.minimum_map_rebuilds < 1
        or arguments.maximum_match_rejections < 0
        or arguments.minimum_keyframes < 1
        or arguments.minimum_map_messages < 1
        or arguments.minimum_samples < 1
    ):
        parser.error('Route values and regression thresholds must be valid')
    return arguments


def main():
    arguments = parse_arguments()
    rclpy.init()
    node = RepeatedStructureRegression()
    exit_code = 1
    try:
        exit_code = 0 if node.run(arguments) else 1
    except (KeyboardInterrupt, RuntimeError) as error:
        print(f'repeated-structure regression failed: {error}', file=sys.stderr)
    finally:
        node.publish_command(0.0)
        node.destroy_node()
        rclpy.shutdown()
    raise SystemExit(exit_code)


if __name__ == '__main__':
    main()
