<?xml version="1.0" ?>
<!-- A world holding one movable crate, which no acceptance world does. The
     three project worlds are entirely static, so the sampler's behaviour
     around geometry Gazebo may push about has nowhere else to be exercised. -->
<sdf version="1.9">
  <world name="non_static_prop">
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>20 20 0.1</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="loose_crate">
      <static>false</static>
      <pose>3 0 0.25 0 0 0</pose>
      <link name="crate_link">
        <collision name="crate_collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
