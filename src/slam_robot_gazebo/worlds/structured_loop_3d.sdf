<?xml version="1.0"?>
<sdf version="1.10">
  <world name="slam_world">
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.80 0.85 1</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>12 6 14 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -1.0</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>70 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>70 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.64 0.64 0.64 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      A closed ring corridor for 3D LiDAR SLAM. The robot spawns at the origin
      facing +x and returns to it after 72 m: south leg y=0 x 0->24, east leg
      x=24 y 0->12, north leg y=12 x 24->0, west leg x=0 y 12->0. Every leg is
      2.8 m clear between 2.8 m walls.

      Sizing follows the sensor rather than intuition. With a 16-beam,
      +/-15 deg vertical field of view mounted at 0.18 m, a side wall 1.4 m
      away is only sampled over a 0.75 m band, so tall walls alone add nothing
      a 2D scan would not already provide. Structure is therefore placed along
      the sight lines instead: at 6 m the beams span 1.79 m of height and at
      10 m they span 2.86 m, so gantries, stacked shelving and canopies set
      5-15 m down a leg are what actually fill the vertical field of view.
    -->
    <model name="structured_loop">
      <static>true</static>
      <link name="loop_link">

        <!-- Outer shell: x in [-1.5, 25.5], y in [-1.5, 13.5]. -->
        <collision name="outer_south_collision">
          <pose>12.0 -1.5 1.4 0 0 0</pose>
          <geometry><box><size>27.2 0.2 2.8</size></box></geometry>
        </collision>
        <visual name="outer_south_visual">
          <pose>12.0 -1.5 1.4 0 0 0</pose>
          <geometry><box><size>27.2 0.2 2.8</size></box></geometry>
          <material>
            <ambient>0.82 0.84 0.88 1</ambient>
            <diffuse>0.82 0.84 0.88 1</diffuse>
            <pbr><metal>
              <albedo_map>../materials/textures/structured_rgbd_outer_south.png</albedo_map>
              <roughness>0.9</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>

        <collision name="outer_north_collision">
          <pose>12.0 13.5 1.4 0 0 0</pose>
          <geometry><box><size>27.2 0.2 2.8</size></box></geometry>
        </collision>
        <visual name="outer_north_visual">
          <pose>12.0 13.5 1.4 0 0 0</pose>
          <geometry><box><size>27.2 0.2 2.8</size></box></geometry>
          <material>
            <ambient>0.82 0.84 0.88 1</ambient>
            <diffuse>0.82 0.84 0.88 1</diffuse>
            <pbr><metal>
              <albedo_map>../materials/textures/structured_rgbd_outer_north.png</albedo_map>
              <roughness>0.9</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>

        <collision name="outer_west_collision">
          <pose>-1.5 6.0 1.4 0 0 0</pose>
          <geometry><box><size>0.2 15.2 2.8</size></box></geometry>
        </collision>
        <visual name="outer_west_visual">
          <pose>-1.5 6.0 1.4 0 0 0</pose>
          <geometry><box><size>0.2 15.2 2.8</size></box></geometry>
          <material>
            <ambient>0.82 0.84 0.88 1</ambient>
            <diffuse>0.82 0.84 0.88 1</diffuse>
            <pbr><metal>
              <albedo_map>../materials/textures/structured_rgbd_outer_west.png</albedo_map>
              <roughness>0.9</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>

        <collision name="outer_east_collision">
          <pose>25.5 6.0 1.4 0 0 0</pose>
          <geometry><box><size>0.2 15.2 2.8</size></box></geometry>
        </collision>
        <visual name="outer_east_visual">
          <pose>25.5 6.0 1.4 0 0 0</pose>
          <geometry><box><size>0.2 15.2 2.8</size></box></geometry>
          <material>
            <ambient>0.82 0.84 0.88 1</ambient>
            <diffuse>0.82 0.84 0.88 1</diffuse>
            <pbr><metal>
              <albedo_map>../materials/textures/structured_rgbd_outer_east.png</albedo_map>
              <roughness>0.9</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>

        <!-- Inner block: x in [1.5, 22.5], y in [1.5, 10.5]. -->
        <collision name="inner_south_collision">
          <pose>12.0 1.5 1.4 0 0 0</pose>
          <geometry><box><size>21.2 0.2 2.8</size></box></geometry>
        </collision>
        <visual name="inner_south_visual">
          <pose>12.0 1.5 1.4 0 0 0</pose>
          <geometry><box><size>21.2 0.2 2.8</size></box></geometry>
          <material>
            <ambient>0.76 0.78 0.82 1</ambient>
            <diffuse>0.76 0.78 0.82 1</diffuse>
            <pbr><metal>
              <albedo_map>../materials/textures/structured_rgbd_inner_south.png</albedo_map>
              <roughness>0.9</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>

        <collision name="inner_north_collision">
          <pose>12.0 10.5 1.4 0 0 0</pose>
          <geometry><box><size>21.2 0.2 2.8</size></box></geometry>
        </collision>
        <visual name="inner_north_visual">
          <pose>12.0 10.5 1.4 0 0 0</pose>
          <geometry><box><size>21.2 0.2 2.8</size></box></geometry>
          <material>
            <ambient>0.76 0.78 0.82 1</ambient>
            <diffuse>0.76 0.78 0.82 1</diffuse>
            <pbr><metal>
              <albedo_map>../materials/textures/structured_rgbd_inner_north.png</albedo_map>
              <roughness>0.9</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>

        <collision name="inner_west_collision">
          <pose>1.5 6.0 1.4 0 0 0</pose>
          <geometry><box><size>0.2 9.2 2.8</size></box></geometry>
        </collision>
        <visual name="inner_west_visual">
          <pose>1.5 6.0 1.4 0 0 0</pose>
          <geometry><box><size>0.2 9.2 2.8</size></box></geometry>
          <material>
            <ambient>0.76 0.78 0.82 1</ambient>
            <diffuse>0.76 0.78 0.82 1</diffuse>
            <pbr><metal>
              <albedo_map>../materials/textures/structured_rgbd_inner_west.png</albedo_map>
              <roughness>0.9</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>

        <collision name="inner_east_collision">
          <pose>22.5 6.0 1.4 0 0 0</pose>
          <geometry><box><size>0.2 9.2 2.8</size></box></geometry>
        </collision>
        <visual name="inner_east_visual">
          <pose>22.5 6.0 1.4 0 0 0</pose>
          <geometry><box><size>0.2 9.2 2.8</size></box></geometry>
          <material>
            <ambient>0.76 0.78 0.82 1</ambient>
            <diffuse>0.76 0.78 0.82 1</diffuse>
            <pbr><metal>
              <albedo_map>../materials/textures/structured_rgbd_inner_east.png</albedo_map>
              <roughness>0.9</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>

        <!--
          South leg: 24 m of smooth parallel wall with a single low marker at
          each end. The middle 21 m carries no longitudinal geometry, which
          makes along-corridor translation weakly observable. It is weak, not
          absent: the 20 m LiDAR still reaches both end walls from the middle
          of a 27 m shell, so a fully rank-deficient 3D segment would need a
          leg longer than 40 m and belongs in a dedicated world.
        -->
        <collision name="south_entry_marker_collision">
          <pose>1.6 -1.05 0.25 0 0 0</pose>
          <geometry><box><size>0.4 0.4 0.5</size></box></geometry>
        </collision>
        <visual name="south_entry_marker_visual">
          <pose>1.6 -1.05 0.25 0 0 0</pose>
          <geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material>
            <ambient>0.20 0.62 0.34 1</ambient>
            <diffuse>0.20 0.62 0.34 1</diffuse>
          </material>
        </visual>

        <collision name="south_exit_marker_collision">
          <pose>22.4 1.05 0.30 0 0 0.30</pose>
          <geometry><box><size>0.5 0.3 0.6</size></box></geometry>
        </collision>
        <visual name="south_exit_marker_visual">
          <pose>22.4 1.05 0.30 0 0 0.30</pose>
          <geometry><box><size>0.5 0.3 0.6</size></box></geometry>
          <material>
            <ambient>0.88 0.48 0.18 1</ambient>
            <diffuse>0.88 0.48 0.18 1</diffuse>
          </material>
        </visual>

        <!--
          East leg: the first overhead member is a navigation clearance gate.
          Its 0.55 m opening clears the complete 0.35 m robot and the 0.45 m
          navigation swept-height contract. The other gantries retain 2.08 m
          clearance as high 3D structure.
        -->
        <collision name="east_clearance_portal_header_collision">
          <pose>24.0 3.0 0.625 0 0 0</pose>
          <geometry><box><size>2.8 0.30 0.15</size></box></geometry>
        </collision>
        <visual name="east_clearance_portal_header_visual">
          <pose>24.0 3.0 0.625 0 0 0</pose>
          <geometry><box><size>2.8 0.30 0.15</size></box></geometry>
          <material>
            <ambient>0.18 0.68 0.78 1</ambient>
            <diffuse>0.18 0.68 0.78 1</diffuse>
          </material>
        </visual>

        <collision name="east_clearance_portal_inner_jamb_collision">
          <pose>22.80 3.0 0.275 0 0 0</pose>
          <geometry><box><size>0.40 0.30 0.55</size></box></geometry>
        </collision>
        <visual name="east_clearance_portal_inner_jamb_visual">
          <pose>22.80 3.0 0.275 0 0 0</pose>
          <geometry><box><size>0.40 0.30 0.55</size></box></geometry>
          <material>
            <ambient>0.18 0.68 0.78 1</ambient>
            <diffuse>0.18 0.68 0.78 1</diffuse>
          </material>
        </visual>

        <collision name="east_clearance_portal_outer_jamb_collision">
          <pose>25.20 3.0 0.275 0 0 0</pose>
          <geometry><box><size>0.40 0.30 0.55</size></box></geometry>
        </collision>
        <visual name="east_clearance_portal_outer_jamb_visual">
          <pose>25.20 3.0 0.275 0 0 0</pose>
          <geometry><box><size>0.40 0.30 0.55</size></box></geometry>
          <material>
            <ambient>0.18 0.68 0.78 1</ambient>
            <diffuse>0.18 0.68 0.78 1</diffuse>
          </material>
        </visual>

        <collision name="east_gantry_b_collision">
          <pose>24.0 6.0 2.20 0 0 0</pose>
          <geometry><box><size>2.8 0.30 0.24</size></box></geometry>
        </collision>
        <visual name="east_gantry_b_visual">
          <pose>24.0 6.0 2.20 0 0 0</pose>
          <geometry><box><size>2.8 0.30 0.24</size></box></geometry>
          <material>
            <ambient>0.45 0.50 0.58 1</ambient>
            <diffuse>0.45 0.50 0.58 1</diffuse>
          </material>
        </visual>

        <collision name="east_gantry_c_collision">
          <pose>24.0 9.0 2.20 0 0 0</pose>
          <geometry><box><size>2.8 0.30 0.24</size></box></geometry>
        </collision>
        <visual name="east_gantry_c_visual">
          <pose>24.0 9.0 2.20 0 0 0</pose>
          <geometry><box><size>2.8 0.30 0.24</size></box></geometry>
          <material>
            <ambient>0.45 0.50 0.58 1</ambient>
            <diffuse>0.45 0.50 0.58 1</diffuse>
          </material>
        </visual>

        <collision name="east_tall_shelf_collision">
          <pose>25.0 4.6 1.10 0 0 0</pose>
          <geometry><box><size>0.7 2.0 2.2</size></box></geometry>
        </collision>
        <visual name="east_tall_shelf_visual">
          <pose>25.0 4.6 1.10 0 0 0</pose>
          <geometry><box><size>0.7 2.0 2.2</size></box></geometry>
          <material>
            <ambient>0.58 0.46 0.34 1</ambient>
            <diffuse>0.58 0.46 0.34 1</diffuse>
          </material>
        </visual>

        <collision name="east_mid_shelf_collision">
          <pose>25.0 7.8 0.65 0 0 0</pose>
          <geometry><box><size>0.7 1.6 1.3</size></box></geometry>
        </collision>
        <visual name="east_mid_shelf_visual">
          <pose>25.0 7.8 0.65 0 0 0</pose>
          <geometry><box><size>0.7 1.6 1.3</size></box></geometry>
          <material>
            <ambient>0.58 0.46 0.34 1</ambient>
            <diffuse>0.58 0.46 0.34 1</diffuse>
          </material>
        </visual>

        <collision name="east_low_pallet_collision">
          <pose>23.0 10.0 0.20 0 0 0</pose>
          <geometry><box><size>0.8 1.2 0.4</size></box></geometry>
        </collision>
        <visual name="east_low_pallet_visual">
          <pose>23.0 10.0 0.20 0 0 0</pose>
          <geometry><box><size>0.8 1.2 0.4</size></box></geometry>
          <material>
            <ambient>0.70 0.60 0.30 1</ambient>
            <diffuse>0.70 0.60 0.30 1</diffuse>
          </material>
        </visual>

        <!--
          North leg: three shelving stacks whose heights step 0.6 -> 1.4 ->
          2.3 m, so the same footprint returns a different vertical profile at
          each stop. A canopy plate spans the corridor further west.
        -->
        <collision name="north_step_low_collision">
          <pose>19.0 11.05 0.30 0 0 0</pose>
          <geometry><box><size>2.0 0.7 0.6</size></box></geometry>
        </collision>
        <visual name="north_step_low_visual">
          <pose>19.0 11.05 0.30 0 0 0</pose>
          <geometry><box><size>2.0 0.7 0.6</size></box></geometry>
          <material>
            <ambient>0.52 0.65 0.80 1</ambient>
            <diffuse>0.52 0.65 0.80 1</diffuse>
          </material>
        </visual>

        <collision name="north_step_mid_collision">
          <pose>15.0 11.05 0.70 0 0 0</pose>
          <geometry><box><size>2.0 0.7 1.4</size></box></geometry>
        </collision>
        <visual name="north_step_mid_visual">
          <pose>15.0 11.05 0.70 0 0 0</pose>
          <geometry><box><size>2.0 0.7 1.4</size></box></geometry>
          <material>
            <ambient>0.52 0.65 0.80 1</ambient>
            <diffuse>0.52 0.65 0.80 1</diffuse>
          </material>
        </visual>

        <collision name="north_step_high_collision">
          <pose>11.0 11.05 1.15 0 0 0</pose>
          <geometry><box><size>2.0 0.7 2.3</size></box></geometry>
        </collision>
        <visual name="north_step_high_visual">
          <pose>11.0 11.05 1.15 0 0 0</pose>
          <geometry><box><size>2.0 0.7 2.3</size></box></geometry>
          <material>
            <ambient>0.52 0.65 0.80 1</ambient>
            <diffuse>0.52 0.65 0.80 1</diffuse>
          </material>
        </visual>

        <collision name="north_canopy_collision">
          <pose>6.0 12.0 2.15 0 0 0</pose>
          <geometry><box><size>2.6 2.8 0.20</size></box></geometry>
        </collision>
        <visual name="north_canopy_visual">
          <pose>6.0 12.0 2.15 0 0 0</pose>
          <geometry><box><size>2.6 2.8 0.20</size></box></geometry>
          <material>
            <ambient>0.45 0.50 0.58 1</ambient>
            <diffuse>0.45 0.50 0.58 1</diffuse>
          </material>
        </visual>

        <collision name="north_column_collision">
          <pose>3.0 13.0 1.40 0 0 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>2.8</length></cylinder></geometry>
        </collision>
        <visual name="north_column_visual">
          <pose>3.0 13.0 1.40 0 0 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>2.8</length></cylinder></geometry>
          <material>
            <ambient>0.40 0.44 0.50 1</ambient>
            <diffuse>0.40 0.44 0.50 1</diffuse>
          </material>
        </visual>

        <!--
          Height-aware navigation target. The 0.07 m stem is intentionally
          much narrower than the 0.40 m cap. The cap spans z=0.18..0.44 m,
          so it overlaps the robot's swept height and its full outline must be
          projected into both RTAB-Map and Nav2 costmaps. It is offset from the
          mapping regression centreline, which remains physically clear.
        -->
        <collision name="north_mushroom_stem_collision">
          <pose>8.5 12.85 0.09 0 0 0</pose>
          <geometry><cylinder><radius>0.07</radius><length>0.18</length></cylinder></geometry>
        </collision>
        <visual name="north_mushroom_stem_visual">
          <pose>8.5 12.85 0.09 0 0 0</pose>
          <geometry><cylinder><radius>0.07</radius><length>0.18</length></cylinder></geometry>
          <material>
            <ambient>0.86 0.24 0.18 1</ambient>
            <diffuse>0.86 0.24 0.18 1</diffuse>
          </material>
        </visual>

        <collision name="north_mushroom_cap_collision">
          <pose>8.5 12.85 0.31 0 0 0</pose>
          <geometry><cylinder><radius>0.40</radius><length>0.26</length></cylinder></geometry>
        </collision>
        <visual name="north_mushroom_cap_visual">
          <pose>8.5 12.85 0.31 0 0 0</pose>
          <geometry><cylinder><radius>0.40</radius><length>0.26</length></cylinder></geometry>
          <material>
            <ambient>0.96 0.52 0.12 1</ambient>
            <diffuse>0.96 0.52 0.12 1</diffuse>
          </material>
        </visual>

        <!--
          West leg: the landmark cluster the loop closes against. Shapes and
          heights are deliberately all different so proximity detection has an
          unambiguous signature on return; bag-of-words is unavailable because
          the robot carries no camera.
        -->
        <collision name="west_pillar_collision">
          <pose>0.85 9.0 1.20 0 0 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>2.4</length></cylinder></geometry>
        </collision>
        <visual name="west_pillar_visual">
          <pose>0.85 9.0 1.20 0 0 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>2.4</length></cylinder></geometry>
          <material>
            <ambient>0.20 0.62 0.34 1</ambient>
            <diffuse>0.20 0.62 0.34 1</diffuse>
          </material>
        </visual>

        <collision name="west_angled_block_collision">
          <pose>-0.95 6.5 0.80 0 0 0.40</pose>
          <geometry><box><size>0.5 0.9 1.6</size></box></geometry>
        </collision>
        <visual name="west_angled_block_visual">
          <pose>-0.95 6.5 0.80 0 0 0.40</pose>
          <geometry><box><size>0.5 0.9 1.6</size></box></geometry>
          <material>
            <ambient>0.88 0.48 0.18 1</ambient>
            <diffuse>0.88 0.48 0.18 1</diffuse>
          </material>
        </visual>

        <collision name="west_wide_block_collision">
          <pose>0.90 4.0 0.35 0 0 0</pose>
          <geometry><box><size>0.6 1.4 0.7</size></box></geometry>
        </collision>
        <visual name="west_wide_block_visual">
          <pose>0.90 4.0 0.35 0 0 0</pose>
          <geometry><box><size>0.6 1.4 0.7</size></box></geometry>
          <material>
            <ambient>0.70 0.60 0.30 1</ambient>
            <diffuse>0.70 0.60 0.30 1</diffuse>
          </material>
        </visual>

        <collision name="west_tower_base_collision">
          <pose>-0.95 2.0 0.45 0 0 0</pose>
          <geometry><box><size>0.5 0.8 0.9</size></box></geometry>
        </collision>
        <visual name="west_tower_base_visual">
          <pose>-0.95 2.0 0.45 0 0 0</pose>
          <geometry><box><size>0.5 0.8 0.9</size></box></geometry>
          <material>
            <ambient>0.62 0.32 0.62 1</ambient>
            <diffuse>0.62 0.32 0.62 1</diffuse>
          </material>
        </visual>

        <collision name="west_tower_top_collision">
          <pose>-0.95 2.0 1.35 0 0 0</pose>
          <geometry><box><size>0.3 0.5 0.9</size></box></geometry>
        </collision>
        <visual name="west_tower_top_visual">
          <pose>-0.95 2.0 1.35 0 0 0</pose>
          <geometry><box><size>0.3 0.5 0.9</size></box></geometry>
          <material>
            <ambient>0.62 0.32 0.62 1</ambient>
            <diffuse>0.62 0.32 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.75 0.80 0.85</background_color>
        <camera_pose>12 -14 18 0 0.75 1.30</camera_pose>
        <camera_clip><near>0.10</near><far>1000</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
