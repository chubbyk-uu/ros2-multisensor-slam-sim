<?xml version="1.0"?>
<sdf version="1.10">
  <world name="slam_world">
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.80 0.85 1</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>25 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -1.0</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>90 20</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>90 20</size></plane>
          </geometry>
          <material>
            <ambient>0.64 0.64 0.64 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      The robot starts at x=0 and drives toward +x. The end walls are at
      x=-5 and x=65. With the standard 20 m LiDAR range, neither end wall nor
      either asymmetric anchor is visible in x=[25, 39] after old anchored
      keyframes have also left the local submap. Only two parallel
      vertical walls and the horizontal floor remain, so planar translation
      along x is geometrically unobservable while y and yaw stay constrained.
    -->
    <model name="degenerate_corridor_3d">
      <static>true</static>
      <link name="corridor_link">
        <collision name="north_wall_collision">
          <pose>30 1.50 1.40 0 0 0</pose>
          <geometry><box><size>70.2 0.20 2.80</size></box></geometry>
        </collision>
        <visual name="north_wall_visual">
          <pose>30 1.50 1.40 0 0 0</pose>
          <geometry><box><size>70.2 0.20 2.80</size></box></geometry>
          <material>
            <ambient>0.82 0.84 0.88 1</ambient>
            <diffuse>0.82 0.84 0.88 1</diffuse>
          </material>
        </visual>

        <collision name="south_wall_collision">
          <pose>30 -1.50 1.40 0 0 0</pose>
          <geometry><box><size>70.2 0.20 2.80</size></box></geometry>
        </collision>
        <visual name="south_wall_visual">
          <pose>30 -1.50 1.40 0 0 0</pose>
          <geometry><box><size>70.2 0.20 2.80</size></box></geometry>
          <material>
            <ambient>0.82 0.84 0.88 1</ambient>
            <diffuse>0.82 0.84 0.88 1</diffuse>
          </material>
        </visual>

        <collision name="entrance_wall_collision">
          <pose>-5 0 1.40 0 0 0</pose>
          <geometry><box><size>0.20 3.20 2.80</size></box></geometry>
        </collision>
        <visual name="entrance_wall_visual">
          <pose>-5 0 1.40 0 0 0</pose>
          <geometry><box><size>0.20 3.20 2.80</size></box></geometry>
          <material>
            <ambient>0.35 0.55 0.82 1</ambient>
            <diffuse>0.35 0.55 0.82 1</diffuse>
          </material>
        </visual>

        <collision name="exit_wall_collision">
          <pose>65 0 1.40 0 0 0</pose>
          <geometry><box><size>0.20 3.20 2.80</size></box></geometry>
        </collision>
        <visual name="exit_wall_visual">
          <pose>65 0 1.40 0 0 0</pose>
          <geometry><box><size>0.20 3.20 2.80</size></box></geometry>
          <material>
            <ambient>0.35 0.55 0.82 1</ambient>
            <diffuse>0.35 0.55 0.82 1</diffuse>
          </material>
        </visual>

        <collision name="entrance_anchor_collision">
          <pose>-2.0 0.95 0.75 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.20</radius><length>1.50</length></cylinder>
          </geometry>
        </collision>
        <visual name="entrance_anchor_visual">
          <pose>-2.0 0.95 0.75 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.20</radius><length>1.50</length></cylinder>
          </geometry>
          <material>
            <ambient>0.20 0.62 0.34 1</ambient>
            <diffuse>0.20 0.62 0.34 1</diffuse>
          </material>
        </visual>

        <collision name="exit_anchor_collision">
          <pose>62.0 -0.92 0.65 0 0 0.35</pose>
          <geometry><box><size>0.70 0.40 1.30</size></box></geometry>
        </collision>
        <visual name="exit_anchor_visual">
          <pose>62.0 -0.92 0.65 0 0 0.35</pose>
          <geometry><box><size>0.70 0.40 1.30</size></box></geometry>
          <material>
            <ambient>0.88 0.48 0.18 1</ambient>
            <diffuse>0.88 0.48 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.75 0.80 0.85</background_color>
        <camera_pose>20 -10 9 0 0.45 0.45</camera_pose>
        <camera_clip><near>0.10</near><far>1000</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">docked</property>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
    </gui>
  </world>
</sdf>
