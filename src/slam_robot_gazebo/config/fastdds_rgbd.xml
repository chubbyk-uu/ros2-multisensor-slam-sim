<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS transport capacity for the RGB-D bridge writers.

  The default 640 x 480 streams contain 921600 bytes of RGB8 pixels and
  1228800 bytes of 32FC1 depth values per frame. The optional organized
  XYZRGB cloud can approach 640 x 480 x 32 = 9830400 bytes. All exceed the
  roughly 512 KiB shared-memory segment that motivated the same protection in
  the climbot project.

  Apply this profile only to rgbd_image_bridge and rgbd_pointcloud_bridge.
  Readers map the writer-owned segment and do not need to reserve another
  64 MiB segment. The generic bridge remains separate so serialization or
  flow control for images cannot starve /clock, odometry, IMU or commands.
-->
<dds xmlns="http://www.eprosima.com">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>slam_rgbd_shm</transport_id>
        <type>SHM</type>
        <segment_size>67108864</segment_size>
        <port_queue_capacity>4096</port_queue_capacity>
        <!-- This is a fragment size, not the complete sample size. -->
        <maxMessageSize>524288</maxMessageSize>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>slam_rgbd_udp</transport_id>
        <type>UDPv4</type>
        <sendBufferSize>4194304</sendBufferSize>
        <receiveBufferSize>4194304</receiveBufferSize>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="slam_rgbd" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>slam_rgbd_shm</transport_id>
          <transport_id>slam_rgbd_udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
