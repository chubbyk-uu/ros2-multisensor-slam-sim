<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>slam_robot_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch and configuration package for the SLAM simulation robot.</description>

  <maintainer email="jerry@example.com">Jerry</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>slam_robot_description</exec_depend>
  <exec_depend>slam_robot_gazebo</exec_depend>
  <exec_depend>slam_robot_navigation</exec_depend>
  <exec_depend>slam_robot_slam</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
