# ROS 2 / colcon build outputs
build/
install/
log/
bags/

# RTAB-Map SQLite databases. The launch default is ~/.ros/rtabmap_3d.db, which
# is outside the repository on purpose so it does not depend on the launching
# terminal's working directory; these rules only cover an explicit
# database_path:=maps/... override.
maps/*.db
maps/*.db-shm
maps/*.db-wal
maps/*.db-journal

# Editor and operating-system files
.vscode/
.idea/
*.swp
*~
.DS_Store

# Python caches used by launch and helper scripts
__pycache__/
*.py[cod]
