# ROS 2 / colcon build outputs
build/
install/
log/
bags/

# Mapping output. maps/ is the working directory every mapping run writes into,
# so nothing loose in it belongs to the repository. The curated demo maps live
# in maps/reference/ and stay tracked: a gitignore '*' does not cross '/', so
# none of these rules reach into that subdirectory. Promoting a map is then an
# explicit copy rather than a side effect of pressing Ctrl+C.
maps/*.pgm
maps/*.yaml
maps/*.posegraph
maps/*.data

# RTAB-Map SQLite databases. The launch default is ~/.ros/rtabmap_3d.db, which
# is outside the repository on purpose so it does not depend on the launching
# terminal's working directory; these rules only cover an explicit
# database_path:=maps/... override.
maps/*.db
maps/*.db-shm
maps/*.db-wal
maps/*.db-journal

# Editor and operating-system files
.vscode/
.idea/
*.swp
*~
.DS_Store

# Python caches used by launch and helper scripts
__pycache__/
*.py[cod]
campaign_logs/
snapshot_resume_reports/
snapshot_resume_reports_run.log
selection_logs/
selection_campaign.log
